        "section_image_rounded_corners": "xl",
        "this_heading": "Dit heb je nodig:",
        "this_content": "<ul><li>Een steelpannetje<\/li><li>Een schaaltje<\/li><li>Een mes<\/li><li>Een lepel<\/li><li>Natuurlijke lippenbalsem van The Lekker Company<\/li><li>Natuurlijke lippenstift naar keuze, wij gebruikten de lippenstift van Boho Green Make-up<\/li><\/ul>",
        "text_box_position": "center-left",
        "block_heading_font_size": "lg",
