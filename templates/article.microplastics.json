            "button_target": false
          }
        },
        "341b18db-4f30-48c8-b378-ff6111966d22": {
          "type": "text_column",
          "settings": {
            "block_heading": "Oplossingen",
            "block_content": "<p>Het is tof dat er veel organisaties en initiatieven zijn die het bewustzijn van dit probleem vergroten en zich richten op de oplossing ervan. Wij willen dit graag supporten! Daarom steunde (begin 2021) The Lekker Company de milieuorganisatie<a href=\"https:\/\/www.lessplastic.org.uk\/\">Less Plastic<\/a>en hopen wij hiermee ons steentje te kunnen bijdragen aan een betere wereld.<\/p>",
            "block_align": "left",
            "block_heading_font_size": "lg",
            "block_heading_font_color": "red",
            "block_text_font_size": "xs",
            "block_text_font_color": "black",
            "max_heading_width": "500",
