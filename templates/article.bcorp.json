        "section_image_size": "original",
        "section_image_rounded_corners": "xl",
        "this_heading": "Wat betekent BCorp?",
        "this_content": "<p>Misschien vraag je je nu wel af: wat betekent het om een B Corp onderneming te zijn? En waarom zijn wij als B Corp onderneming zo trots op deze certificering? Dit leggen we je graag uit!<\/p>",
        "text_box_position": "center-left",
        "block_heading_font_size": "xl",
        "block_heading_font_color": "red",
        "block_text_font_size": "xs",
        "block_text_font_color": "black",
        "max_heading_width": "10",
