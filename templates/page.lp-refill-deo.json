    "eerste_week_intro": {
      "type": "theme-section__text",
      "blocks": {
        "intro": {
          "type": "text_column",
          "settings": {
            "block_heading": "eerlijk: de eerste week is even wennen",
            "block_content": "<p>Stap je over van een antitranspirant? Dan moeten je oksels even wennen. Weet je wat er gebeurt, dan hou je het makkelijker vol.</p>",
            "block_align": "center",
            "block_heading_font_size": "lg",
            "block_heading_font_color": "black",
