    "eerste_week_stappen": {
      "type": "theme-section__text",
      "blocks": {
        "stap1": {
          "type": "text_column",
          "settings": {
            "block_heading": "dag 1 tot 3",
            "block_content": "<p><strong>Je zweet misschien wat meer.</strong> Je oksels wennen eraan dat ze niet meer worden dichtgezet. Dat is normaal. Smeer één keer per dag op een schone, droge huid.</p>",
            "block_align": "left",
            "block_heading_font_size": "md",
            "block_heading_font_color": "red",
            "block_text_font_size": "xs",
            "block_text_font_color": "black",
            "block_text_style": "normal",
            "button_show": false
          }
        },
        "stap2": {
          "type": "text_column",
          "settings": {
            "block_heading": "dag 4 tot 10",
            "block_content": "<p><strong>Je lichaam vindt zijn balans.</strong> Ruik je tussendoor iets? Was je oksels met water en breng opnieuw aan. Val niet terug op je oude deo, anders begin je weer opnieuw.</p>",
            "block_align": "left",
            "block_heading_font_size": "md",
            "block_heading_font_color": "red",
            "block_text_font_size": "xs",
            "block_text_font_color": "black",
            "block_text_style": "normal",
            "button_show": false
          }
        },
        "stap3": {
          "type": "text_column",
          "settings": {
            "block_heading": "na een week of twee",
            "block_content": "<p><strong>Gewend.</strong> Voor de meeste mensen is het wennen dan voorbij. Vanaf nu is het gewoon smeren en gaan.</p>",
            "block_align": "left",
            "block_heading_font_size": "md",
            "block_heading_font_color": "red",
            "block_text_font_size": "xs",
            "block_text_font_color": "black",
            "block_text_style": "normal",
            "button_show": true,
            "button_label": "ik probeer het",
            "button_size": "button_small",
            "button_color": "button_red",
            "button_link": "#aanbod",
            "button_target": false
          }
        }
      },
      "block_order": [
        "stap1",
