    "faq": {
      "type": "theme-section__faq-multiple",
      "blocks": {
        "q1": {
          "type": "faq_section_qa",
          "settings": {
            "faq_section_qa_q": "Past de navulling ook in mijn gewone deo stick?",
            "faq_section_qa_a": "<p>Nee. De navulling past alleen in de lichtblauwe herbruikbare koker uit de starter. Daarom begin je met de starter, daarna koop je alleen nog navullingen.</p>"
          }
        },
        "q2": {
          "type": "faq_section_qa",
          "settings": {
            "faq_section_qa_q": "Welke geuren zijn er navulbaar?",
            "faq_section_qa_a": "<p>Be Active (den, bergamot en munt) en Have Fun (mandarijn en citroen). In het starterspakket zitten ze allebei.</p>"
          }
        },
        "q3": {
          "type": "faq_section_qa",
          "settings": {
            "faq_section_qa_q": "Hoe lang duurt het wennen?",
            "faq_section_qa_a": "<p>Stap je over van een antitranspirant? Voor de meeste mensen een week of twee. Blijf één keer per dag smeren op een schone huid en val niet terug op je oude deo.</p>"
          }
        },
        "q4": {
          "type": "faq_section_qa",
          "settings": {
            "faq_section_qa_q": "Waar liggen de navullingen in de winkel?",
            "faq_section_qa_a": "<p>Nergens. De losse deo stick ligt bij onder meer Albert Heijn en Etos, de navulbare koker en de navullingen vind je alleen hier.</p>"
          }
        },
        "q5": {
          "type": "faq_section_qa",
          "settings": {
            "faq_section_qa_q": "Wanneer krijg ik mijn bestelling?",
            "faq_section_qa_a": "<p>Binnen twee werkdagen bezorgd. Vanaf €25 gratis, het starterspakket dus altijd.</p>"
          }
        },
        "q6": {
          "type": "faq_section_qa",
          "settings": {
            "faq_section_qa_q": "Hoe krijg ik de 15% korting?",
            "faq_section_qa_a": "<p>Schrijf je hierboven in voor de nieuwsbrief. Je krijgt de kortingscode per e-mail en vult hem in bij het afrekenen. Geldt op je eerste bestelling.</p>"
          }
        }
      },
