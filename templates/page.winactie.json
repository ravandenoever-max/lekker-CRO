      "settings": {
        "custom_liquid": "<style>\n  .lk-droppie { max-width: 460px; padding: 48px 0 48px; }\n  .lk-droppie .lk-drip__fields { grid-template-columns: 1fr; }\n  .lk-droppie .lk-drip__submit { width: auto; justify-self: start; padding-left: 32px; padding-right: 32px; }\n  .lk-droppie__small { margin: 4px 0 0; opacity: .7; }\n  @media screen and (min-width: 768px) {\n    .lk-droppie { padding: 34px 0 64px; }\n  }\n</style>\n<div class=\"lk-droppie\">\n  <div class=\"lk-drip\" data-lk-drip-location=\"droppie\">\n    <form class=\"lk-drip__form\" action=\"https://www.getdrip.com/forms/893662033/submissions\" method=\"post\" data-lk-drip-form>\n      <div class=\"lk-drip__fields\">\n        <label class=\"lk-drip__sr\" for=\"lk-drip-name-droppie\">Voornaam</label>\n        <input class=\"lk-drip__input font-fam-normal font-size-xs\" type=\"text\" id=\"lk-drip-name-droppie\" name=\"fields[first_name]\" value=\"\" placeholder=\"je voornaam\" autocomplete=\"given-name\" required aria-required=\"true\">\n        <label class=\"lk-drip__sr\" for=\"lk-drip-email-droppie\">E-mailadres</label>\n        <input class=\"lk-drip__input font-fam-normal font-size-xs\" type=\"email\" id=\"lk-drip-email-droppie\" name=\"fields[email]\" value=\"\" placeholder=\"je e-mailadres\" autocomplete=\"email\" required aria-required=\"true\">\n      </div>\n      <input type=\"hidden\" name=\"tags[]\" value=\"bron:droppie\">\n      <div class=\"lk-drip__hp\" aria-hidden=\"true\">\n        <label for=\"lk-drip-website-droppie\">Website</label>\n        <input type=\"text\" id=\"lk-drip-website-droppie\" name=\"website\" tabindex=\"-1\" autocomplete=\"off\" value=\"\">\n      </div>\n      <button type=\"submit\" class=\"lk-drip__submit theme-button theme-button__round-medium theme-button__red-white-red theme-button-hover__red-red-white\"><span>claim mijn deo</span></button>\n      <p class=\"lk-droppie__small font-size-3xs\">Je komt op de nieuwsbrief van The Lekker Company, zodat we je kunnen vragen