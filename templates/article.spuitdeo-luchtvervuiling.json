      "type": "theme-section__text",
      "blocks": {
        "template--14388232454193__5c16352e-030f-4034-b932-09952899f207-166731686620a1ba3e-0": {
          "type": "text_column",
          "settings": {
            "block_heading": "Verzorgingsproducten dragen bij aan luchtvervuiling",
            "block_content": "<p>Veel mensen denken bij luchtvervuiling aan auto’s en vliegtuigen, maar verzorgingsproducten spelen ook een rol. In Nederland is 5 tot 10% van de luchtvervuiling hieraan toe te schrijven. Vooral spuitdeodorant is een grote boosdoener: 90% van de spray komt niet op je huid, maar in de lucht, wat bijdraagt aan smogvorming.<\/p>",
            "block_align": "center",
            "block_heading_font_size": "xl",
