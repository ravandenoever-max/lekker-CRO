            "button_target": false
          }
        },
        "341b18db-4f30-48c8-b378-ff6111966d22": {
          "type": "text_column",
          "settings": {
            "block_heading": "empty",
            "block_content": "<p>[UL][LI]PARFUM – bevat <strong>soms <\/strong>dierlijke ingrediënten, parfum is een verzamelnaam[_LI][LI]RETINOL-<strong>soms <\/strong>uit lever of eieren[_LI][LI]ROYAL JELLY - stof die wordt uitgescheiden via de spijsverteringsbuis van de werkbijen[_LI][LI]SILK POWDER - fijn verpulverde zijde[_LI][LI]STEARIC ACID\/STEARYL ALCOHOL –<strong>soms <\/strong>dierlijk (vet)[_LI][LI]VITAMINEN –<strong>soms <\/strong>op basis van vis[_LI][LI]WHEY PROTEIN - melk proteïnen[_LI][LI]HYDROLYZED PEARL- fijngemalen parel, van levende of gedode weekdieren[_LI][LI]TALLOWATE- talg, gesmolten dierlijk vet[_LI][LI]GLUCOSAMINE - verbinding gevonden in kraakbeen[_LI][_UL] <\/p>",
            "block_align": "left",
            "block_heading_font_size": "lg",
            "block_heading_font_color": "red",
            "block_text_font_size": "xs",
            "block_text_font_color": "black",
            "max_heading_width": "500",
