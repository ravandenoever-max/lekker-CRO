        "e31db75c-93b1-46fe-83a7-106dcec3e3d6": {
          "type": "faq_section_qa",
          "settings": {
            "faq_section_qa_q": "Hoe vaak moet ik de lippenbalsem gebruiken?",
            "faq_section_qa_a": "<p>Zo vaak als jij en je lippen fijn vinden. Onze lippenbalsems zijn praktisch eetbaar en ruikt mega lekker. We snappen daarom dat je er niet vanaf kunt blijven ;)</p>"
          }
        },
        "b8a34cbd-eaf9-4e74-932f-bc2eb5009785": {
          "type": "faq_section_qa",
          "settings": {
            "faq_section_qa_q": "Is jullie lippenbalsem verslavend?",
            "faq_section_qa_a": "<p>Nee. Minerale oliën in andere lippenbalsems sluiten de lippen af en drogen deze uit. Wij gebruiken geen minerale oliën en alleen natuurlijke ingrediënten. Onze lippenbalsems zijn daardoor niet verslavend, maar wel heel lekker!</p>"
          }
        }
      },
