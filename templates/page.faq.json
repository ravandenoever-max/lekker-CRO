        },
        "461923fc-a80b-4b87-9a96-6e50477cbc51": {
          "type": "faq_section_qa",
          "settings": {
            "faq_section_qa_q": "Kan ik een verkooppunt worden?",
            "faq_section_qa_a": "<p>Waarschijnlijk wel! Stuur een mail naar <a href=\"mailto:sales@thelekkercompany.com\" title=\"mailto:sales@thelekkercompany.com\">sales@thelekkercompany.com</a> en dan hoor je snel van ons.<br/>In onze footer staat ook een overzicht met alle b2b verkooplocaties onder het kopje 'zakelijk'.</p>"
          }
