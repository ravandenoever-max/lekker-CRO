        "button_color": "button_black",
        "button_link": "",
        "button_target": false
      }
    },
    "7d087f4b-2017-4c0c-9706-69445141a5b5": {
      "type": "theme-section__visual-text",
      "settings": {
        "row_spacing_inner_top": "xs",
        "row_spacing_inner_bottom": "md",
        "section_background_color": "lpink",
        "section_background_color_b": "white",
        "section_background_color_direction": "image-up",
        "section_background_size": "lg",
        "page_width": "page-width--narrow",
        "layout_order": "image-text",
        "use_animations": true,
        "section_image": "shopify:\/\/shop_images\/Ontwerp_zonder_titel_24.png",
        "section_image_size": "original",
        "section_image_rounded_corners": "xl",
        "this_heading": "De Stap naar Grote Retail",
        "this_content": "<p>Groot feest natuurlijk, totdat ik de volgende dag besefte welke opdracht me stond te wachten. Ik had een assortiment van 20 producten in glazen potten, en had drie schapplekken bij AH. Dit was het moment dat Feddo aan boord kwam om te helpen bij dit proces. We waren het over eens: we kozen voor de deodorant. Met pijn in mijn hart nam ik afscheid van mijn voetenbadjes, lippenbalsems en haarmaskers,<\/p><p>Om aan de eisen van de grote retail te voldoen, moesten de deo-recepten worden verbeterd en labtests worden uitgevoerd. Ik verbeterde mijn recepten wederom met behulp van Pinterest en testte alles op vrienden en familie. <\/p>",
        "text_box_position": "center-left",
        "block_heading_font_size": "xl",
        "block_heading_font_color": "red",
        "block_text_font_size": "xs",
        "block_text_font_color": "black",
        "max_heading_width": "10",
