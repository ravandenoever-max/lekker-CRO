{%- liquid
  assign filename = 'cart-product-variant-details' 
  assign from_version = 'from_' | append: version

  assign list_items = 'horizontal'
  assign list_items_class = 'gl-f-hor gl-g-2xs gl-f-left gl-f-middle'
  if version == 'drawer'
    assign list_items = 'vertical'
    assign list_items_class = 'gl-f-vert gl-g-none gl-f-left gl-f-top'
  endif
-%}
{%- if item.product.has_only_default_variant == false or item.properties.size > 0 or item.selling_plan_allocation != nil -%}
  <div class="{{ list_items_class }}">
    {%- if item.product.has_only_default_variant == false -%}
      {%- assign forloop_value_index = 0 -%}
      {%- for option in item.options_with_values -%}
        {%- liquid
          assign show_continue = true
          assign forloop_value_index = forloop_value_index | plus : 1                                      
          assign option_name = option.name 
          assign option_name = option_name | replace: 'title' , 'Size' | replace: 'Title' , 'Size' 
          assign option_name_label = option.name
          assign option_name_downcase = option_name | downcase
          assign option_name_clean = option_name | handleize | downcase
          assign option_value = option.value
          assign option_value_label = option_value
          assign option_value_downcase = option_value | downcase
          assign option_value_clean = option_value | handleize | downcase

          capture option_name_translated
            render 'translate_input_to_current_language', translation_key:option_name_clean,translation_fallback:option_name_label
          endcapture
          capture option_value_translated
            render 'translate_input_to_current_language', translation_key:option_value_clean,translation_fallback:option_value_label
          endcapture

          assign option_this_id = 'label__[A]_[B]' | replace:'[A]',from_version | replace:'[B]',option_value_clean 
          assign settings_optionNames = settings.optionName | split:","
        -%}
        {%- if show_continue == true -%}
          <div class="theme-f-hor theme-g-6xs theme-f-left theme-f-middle {{ option_this_id }} use-color-{{ useColor }}">
            <div class="attribute-icon theme-hidden">
              <div class="theme-icon-size">{% render 'theme-icon', icon: 'icon-close' %}</div>
            </div>
            <span class="attribute-label" for="{{ option_this_id }}">{{ option_value_translated }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}         
    {%- endif -%}

  {%- if item.selling_plan_allocation.selling_plan.name != blank -%}                          
    <p class="product-option">
      <span>{{ item.selling_plan_allocation.selling_plan.name }}</span>
    </p>
  {%- endif -%}
  </div>
{%- endif -%}