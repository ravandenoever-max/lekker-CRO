{%- comment -%}
  Koopblok onder de koopknop op de productpagina: voordelen, twijfels en bezorging.
  Inhoud per productlijn via de blokken "Koopblok (CRO)" in de productsectie. Parameter: b (het blok).
  Let op: gaat door de inline-html minifier. JavaScript alleen zonder // commentaar en met puntkomma's.
  Toegevoegd november 2026, CRO-project (1.5).
  Bevat ook de kleuraanpassingen op de productpagina uit de feedback van Esther (11 november): knop combideals groen, reviews en 'iets voor jou?' lichtblauw.
{%- endcomment -%}
{%- assign s = b.settings -%}
{%- comment -%}
  "ook in navulbare versie" alleen tonen als er van deze geur een navulbare versie is (refill uit Reviewgroep refill-deo met dezelfde geur, starter eerst).
  Geuren komen uit het productveld lekker.geur. Geen navulbare versie: alternatieve USP (kb_alt). Toegevoegd 18 nov.
{%- endcomment -%}
{%- liquid
  assign kb_geur = ''
  assign kb_refill_url = ''
  assign kb_pg = product.metafields.lekker.geur.value
  assign kb_rg = metaobjects.lekker_reviewgroep['refill-deo'].producten.value
  for kb_pass in (1..2)
    for g in kb_pg
      for rp in kb_rg
        if kb_refill_url == blank
          if kb_pass == 2 or rp.handle contains 'starter'
            for rgeur in rp.metafields.lekker.geur.value
              if rgeur.system.handle == g.system.handle
                assign kb_refill_url = rp.url
                if kb_pg.size == 1
                  assign kb_geur = g.naam.value
                endif
              endif
            endfor
          endif
        endif
      endfor
    endfor
  endfor
  if request.locale.iso_code == 'en'
    assign kb_alt = 'helps you smell fresh all day'
    assign kb_more = 'more about this product'
  else
    assign kb_alt = 'helpt je de hele dag lekker te ruiken'
    assign kb_more = 'meer over dit product'
  endif
-%}
<div class="lk-buy margin-b-xs" {{ b.shopify_attributes }}>
  {%- if s.usp_1 != blank or s.usp_2 != blank or s.usp_3 != blank or s.usp_4 != blank -%}
    <ul class="lk-buy__usps" role="list">
      {%- for i in (1..4) -%}
        {%- assign kb_key = 'usp_' | append: i -%}
        {%- assign kb_usp = s[kb_key] -%}
        {%- if kb_usp == blank -%}{%- continue -%}{%- endif -%}
        {%- if kb_usp contains 'navulbare versie' -%}
          {%- if kb_refill_url != blank -%}
            <li class="font-size-xs"><span class="lk-buy__check" aria-hidden="true"></span><span>{% if kb_geur != blank %}{{ kb_geur }} is er ook {% else %}ook {% endif %}in <a href="{{ kb_refill_url }}" class="lk-buy__link">navulbare versie</a></span></li>
          {%- else -%}
            <li class="font-size-xs"><span class="lk-buy__check" aria-hidden="true"></span>{{ kb_alt }}</li>
          {%- endif -%}
        {%- else -%}
          <li class="font-size-xs"><span class="lk-buy__check" aria-hidden="true"></span>{{ kb_usp }}</li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}
  {%- if s.q_1 != blank or s.q_2 != blank or s.q_3 != blank -%}
    <div class="lk-buy__faq">
      {%- if s.q_1 != blank -%}<details class="lk-buy__q"><summary class="font-fam-bold font-size-xs">{{ s.q_1 }}</summary><div class="lk-buy__a font-size-xs">{{ s.a_1 }}</div></details>{%- endif -%}
      {%- if s.q_2 != blank -%}<details class="lk-buy__q"><summary class="font-fam-bold font-size-xs">{{ s.q_2 }}</summary><div class="lk-buy__a font-size-xs">{{ s.a_2 }}</div></details>{%- endif -%}
      {%- if s.q_3 != blank -%}<details class="lk-buy__q"><summary class="font-fam-bold font-size-xs">{{ s.q_3 }}</summary><div class="lk-buy__a font-size-xs">{{ s.a_3 }}</div></details>{%- endif -%}
    </div>
  {%- endif -%}
  {%- if s.delivery != blank or s.returns != blank -%}
    <div class="lk-buy__service">
      {%- if s.delivery != blank -%}
        <p class="font-size-3xs"><svg class="lk-buy__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v9H3zM14 9h4l3 3v3h-7z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="7" cy="17" r="1.8" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="17" cy="17" r="1.8" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>{{ s.delivery }}</p>
      {%- endif -%}
      {%- if s.returns != blank -%}
        <p class="font-size-3xs"><svg class="lk-buy__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 7H4V2M4.5 7A8 8 0 1 1 4 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ s.returns }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>
<style>
  .lk-buy { border: 1px solid rgba(33, 35, 34, .12); border-radius: 20px; padding: 16px 18px; color: var(--color-black); }
  .lk-buy__usps { list-style: none; margin: 0 0 12px; padding: 0; display: grid; gap: 6px; }
  .lk-buy__usps li { display: flex; gap: 10px; align-items: flex-start; margin: 0; }
  .lk-buy__check { flex: 0 0 18px; width: 18px; height: 18px; margin-top: 3px; border-radius: 50%; background: var(--color-red); position: relative; }
  .lk-buy__check::after { content: ""; position: absolute; left: 6px; top: 3px; width: 5px; height: 9px; border: solid var(--color-white); border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .lk-buy__faq { border-top: 1px solid rgba(33, 35, 34, .12); }
  .lk-buy__q { border-bottom: 1px solid rgba(33, 35, 34, .12); }
  .lk-buy__q summary { list-style: none; cursor: pointer; padding: 10px 28px 10px 0; position: relative; text-transform: lowercase; }
  .lk-buy__q summary::-webkit-details-marker { display: none; }
  .lk-buy__q summary::after { content: "+"; position: absolute; right: 4px; top: 50%; transform: translateY(-50%); font-size: 20px; line-height: 1; color: var(--color-red); }
  .lk-buy__q[open] summary::after { content: "\2212"; }
  .lk-buy__a { padding: 0 0 12px; }
  .lk-buy__a p { margin: 0; }
  .lk-buy__service { margin-top: 12px; display: grid; gap: 4px; }
  .lk-buy__service p { margin: 0; display: flex; gap: 8px; align-items: center; opacity: .85; }
  .lk-buy__icon { flex: 0 0 18px; width: 18px; height: 18px; color: var(--color-red); }
  .combi_products .card-wrapper-flex.card-wrapper-hor .card-wrapper-flex__button .theme-button:not(.theme-button__disabled), .combi_products .card-wrapper-flex.card-wrapper-hor .card-wrapper-flex__button .theme-button:not(.theme-button__disabled):hover, .combi_products .card-wrapper-flex.card-wrapper-hor .card-wrapper-flex__button .theme-button:not(.theme-button__disabled):focus, .combi_products .card-wrapper-flex.card-wrapper-hor .card-wrapper-flex__button .theme-button:not(.theme-button__disabled):active { background: #1c5636 !important; border-color: #1c5636 !important; color: var(--color-white) !important; }
  .combi_products .card-wrapper-flex.card-wrapper-hor .card-wrapper-flex__button .theme-button:not(.theme-button__disabled):hover { opacity: .85; }
  .combi_products .theme-button span { color: inherit !important; }
  .lk-buy__link { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .lk-desc { border-top: 1px solid rgba(33, 35, 34, .12); border-bottom: 1px solid rgba(33, 35, 34, .12); margin-bottom: 20px; }
  .lk-desc > summary { list-style: none; cursor: pointer; padding: 12px 28px 12px 0; position: relative; text-transform: lowercase; }
  .lk-desc > summary::-webkit-details-marker { display: none; }
  .lk-desc > summary::after { content: "+"; position: absolute; right: 4px; top: 50%; transform: translateY(-50%); font-size: 20px; line-height: 1; color: var(--color-red); }
  .lk-desc[open] > summary::after { content: "\2212"; }
  .lk-desc .rich-text-content__manual { padding-bottom: 12px; }
  .shopify-section[id$="__theme_section_review_app"], .shopify-section[id$="__173230878117298f18"], .shopify-section[id$="__theme_section_review_app"] .jdgm-widget, .shopify-section[id$="__173230878117298f18"] .jdgm-widget { background: #bedeff !important; }
  .shopify-section[id$="__f0d1584d-9ec4-4165-9f2b-de7174e75a6a"] > .section-inner, .shopify-section[id$="__f0d1584d-9ec4-4165-9f2b-de7174e75a6a"] .bg-lpink, .shopify-section[id$="__f0d1584d-9ec4-4165-9f2b-de7174e75a6a"] .section-inner::after, .shopify-section[id$="__f0d1584d-9ec4-4165-9f2b-de7174e75a6a"] .scrollbar-wrapper::after { background: #bedeff !important; }
  body:has(.lk-buy) { background: var(--color-white) !important; }
  @media screen and (max-width: 767px) {
    .shopify-section[id$="__6576457567457fde"] .elements__items-list { width: auto !important; min-width: 0 !important; display: flex !important; gap: 12px !important; }
    .shopify-section[id$="__6576457567457fde"] .elements__items-list > li.grid__item { width: 112px !important; min-width: 112px !important; max-width: 112px !important; flex: 0 0 112px !important; margin: 0 !important; }
    .shopify-section[id$="__6576457567457fde"] .scrollbar-inner { width: max-content !important; }
  }
</style>
{%- comment -%} Lange productbeschrijving in een uitklapblok (18 nov). De korte beschrijving bovenaan blijft staan. Het laatste lijstje met voordelen valt weg, dat staat al in het koopblok. Zonder JavaScript blijft alles gewoon zichtbaar. {%- endcomment -%}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var box = document.querySelector('.rich-text-content__manual');
    if (!box || box.closest('.lk-desc')) { return; }
    var desc = box.querySelector('.product-desc');
    var last = desc ? desc.lastElementChild : null;
    if (last && (last.tagName === 'UL' || (last.querySelector('ul') && last.textContent.trim() === last.querySelector('ul').textContent.trim()))) { last.style.display = 'none'; }
    var d = document.createElement('details');
    d.className = 'lk-desc';
    var sm = document.createElement('summary');
    sm.className = 'font-fam-bold font-size-xs';
    sm.textContent = {{ kb_more | json }};
    d.appendChild(sm);
    box.parentNode.insertBefore(d, box);
    d.appendChild(box);
  });
</script>
{%- comment -%} Reviews van de hele productlijn (CRO-project 1.4), wordt bij het laden in de reviewsectie gezet {%- endcomment -%}
{%- render 'lekker-reviews' -%}