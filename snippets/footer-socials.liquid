<ul class="footer__list-social list-unstyled list-social">
  {%- if settings.social_twitter_link != blank -%}
    <li class="list-social__item">
      <a target="_blank" title="{{ shop.name | escape }} on Twitter" href="{{ settings.social_twitter_link }}" class="list-social__link color-white" aria-describedby="a11y-external-message">
        {%- render 'theme-icon', icon: 'icon-twitter' -%}
        <span class="visually-hidden">{{ 'general.social.links.twitter' | t }}</span>
      </a>
    </li>
  {%- endif -%}
