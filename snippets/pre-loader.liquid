{%- assign loader_version = 'image' -%}
{%- if loader_version == 'css_dots' -%}
  <div class="page-loader page-loader-css"><div><span class="circle"></span><span class="circle"></span><span class="circle"></span></div></div>
  <style id="loader-css">
    .page-loader{display:inline-block;z-index:9999999999;position:fixed;width:100%;height:100%;max-width:100vw;max-height:100vh;top:0px;right:0px; bottom:0px;left:0px;background-color:var(--color-red);pointer-events:none !important;transition:all 0.5s ease 0s}
    body.page-loader-visible .page-loader{z-index:90000000000;opacity:1;transition:all 0.15s ease 0s}
    body:not(.page-loader-visible) .page-loader{z-index:-10;opacity:0;pointer-events:none}
    .page-loader.page-loader-css{display:flex;justify-content:center;align-items:center}
    .page-loader.page-loader-css>div{height:14px;width:50px;position:relative;display:flex}
    .page-loader.page-loader-css>div .circle{background-color:#000;width:14px;height:14px;border-radius:7px;margin-right:30px}
    .page-loader.page-loader-css>div .circle:nth-child(1){position:absolute;top:0;left:0;animation:page-loader-grow 750ms linear 0ms infinite}
    .page-loader.page-loader-css>div .circle:nth-child(2){animation:page-loader-move 750ms linear 0ms infinite}
    .page-loader.page-loader-css>div .circle:nth-child(3){position:absolute;top:0;right:0;margin-right:0;animation:page-loader-grow 750ms linear 0s infinite reverse}
    @keyframes page-loader-grow{from{transform:scale(0,0);opacity:0} to{transform:scale(1,1);opacity:1}}
    @keyframes page-loader-move{0%{transform:translateX(0px) scale(1,1)} 50%{transform:translateX(18px) scale(1.4,1.4)} 100%{transform:translateX(36px) scale(1,1)}}
  </style>
{%- elsif loader_version == 'image' -%}
  <div class="page-loader"><span><img width="143" height="54" src="{{ settings.website_loader_image | asset_url }}" loading="eager" alt="{{ shop.name | escape }} / Logo"></span></div><style id="loader-css">.page-loader{display:inline-block;z-index:9999999999;position:fixed;width:100%;height:100%;max-width:100vw;max-height:100vh;top:0px;right:0px;bottom:0px;left:0px;background-color:var(--color-lpink);pointer-events:none !important;transition:all 0.3s ease 0.2s, width 0s ease 0s, max-width 0s ease 0s}body.page-loader-visible .page-loader{z-index:9999999999;opacity:1}body:not(.page-loader-visible) .page-loader{z-index:-10;opacity:0;pointer-events:none}.page-loader span{display:inline-block;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:143px;height:54px}.page-loader span img{display:inline-block;width:143px;height:54px}body.page-loader-visible .page-loader span img{transform:translateY(0px);opacity:1;transition:all 0.1s ease 0s}body:not(.page-loader-visible) .page-loader span img{transform:translateY(-10px);opacity:0;transition:all 0.1s ease 0s}</style>
{%- else -%}
  <div class="page-loader"><span></span></div><style id="loader-css">.page-loader{display:inline-block;z-index:9999999999;position:fixed;width:100%;height:100%;top:0px;right:0px; bottom:0px;left:0px;background-color:var(--color-white);pointer-events:none !important;transition:all 0.5s ease 0s}body.page-loader-visible .page-loader{z-index:90000000000;opacity:1;transition:all 0.15s ease 0s}body:not(.page-loader-visible) .page-loader{z-index:-10;opacity:0;pointer-events:none}</style>
{%- endif -%}