{%- capture footer_newsletter_html -%}
  {%- unless version == 'minified_no_text' -%}
  <h2 class="font-fam-normal font-size-lg color-white txtlowercase margin-b-xxs">{{ 'sections.footer.footer_newsletter_title' | t }}</h2>
  <p class="font-fam-normal font-size-sm color-white margin-b-xs">{{ 'sections.footer.footer_newsletter_text' | t }}</p>
  {%- endunless -%}
  {%- liquid
    assign apply_tags = 'newsletter'
    if given_tags != blank
      assign apply_tags = apply_tags | append : ',' | append : given_tags
    endif
  -%}
  {%- form 'customer', class: 'newsletter-form' -%}
    {%- comment -%} ?customer_posted=true {%- endcomment -%}
    {%- if form.posted_successfully? -%}
      <div class="margin-b-xs" style="width:100%;">
        <h3 class="newsletter-form__message newsletter-form__message--success form__message 
          font-fam-normal font-size-md color-white txtlowercase" id="Newsletter-success--{{ section.id }}" tabindex="-1" autofocus>{{ 'newsletter.success' | t }}</h3>
        <script>
          $(window).load(function(){
            var popup_title = '{{ 'newsletter.success' | t }}', popup_message = '';
            CustomAlertConfirm.open({
              this_template: 'popup-message', this_title: popup_title, this_message: popup_message, this_okText: 'Sluiten',
              this_onok: () => { $('#contact_form button').prop("disabled", false); return false; }
            });
          });
        </script>
      </div>
    {%- else -%}
      <div class="newsletter-form__field-wrapper" style="width:100%;">
        <div class="col-field">
          <div class="field">
            <input id="NewsletterForm--{{ section.id }}" type="email" name="contact[email]" class="field__input use-placeholder js-required js-newsletter_email font-fam-normal font-size-sm" value="{{ form.email }}" required aria-required="true" autocorrect="off" autocapitalize="off" autocomplete="email"
              {% if form.errors %}autofocus aria-invalid="true" aria-describedby="Newsletter-error--{{ section.id }}"{% elsif form.posted_successfully? %}aria-describedby="Newsletter-success--{{ section.id }}"{% endif %} placeholder="{{ 'newsletter.label' | t }}">
            <label class="field__label" for="NewsletterForm--{{ section.id }}">{{ 'newsletter.label' | t }}</label>
          </div>
        </div>
        <div class="col-button">
          <div class="css-arrow" data-version="chevron" data-color="white" data-direction="right"><span></span></div>
        </div>
      </div>
      {%- if form.errors -%}
        <small class="newsletter-form__message form__message" id="Newsletter-error--{{ section.id }}">
          {%- render 'theme-icon', icon: 'icon-error' -%}
          {{ form.errors.translated_fields['email'] | capitalize }}
          {{ form.errors.messages['email'] }}
        </small>
      {%- endif -%}
      <div class="visibility-hidden"><button type="submit" class="js-trigger-me-button" name="commit">{{ 'newsletter.button_label' | t }}</button></div>
      <input type="hidden" name="contact[tags]" value="{{ apply_tags }}">
    {%- endif -%}
  {%- endform -%}
  <input id="all_required_error" type="hidden" value="{{ 'newsletter.all_required_error' | t }}">
  <input id="input_email_error" type="hidden" value="{{ 'newsletter.input_email_error' | t }}">

{%- endcapture -%}
{%- liquid
  assign minify_this_html_input = footer_newsletter_html
  assign minify_this_html_block = true
  if minify_this_html_block == true and settings.website_minify_inline_html != 'false'
    render'inline-html',input_html:minify_this_html_input
  else
    echo minify_this_html_input
  endif
-%}