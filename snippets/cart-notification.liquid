<cart-notification class="js-hide-below-768">
  <div class="cart-notification-wrapper page-width">
    <div id="cart-notification" class="cart-notification focus-inset" aria-modal="true" aria-label="{{ 'general.cart.item_added' | t }}" role="dialog" tabindex="-1">
      <div class="cart-notification__header">
        <h2 class="cart-notification__heading caption-large">{%- render 'theme-icon', icon: 'icon-checkmark' -%} {{ 'general.cart.item_added' | t }}</h2>
        <button type="button" class="cart-notification__close modal__close-button link link--text focus-inset" aria-label="{{ 'accessibility.close' | t }}">
          <svg class="icon icon-close" aria-hidden="true" focusable="false"><use href="#icon-close"></svg>
        </button>
      </div>
      <div id="cart-notification-product" class="cart-notification-product">
          <!-- notification placeholder -->
      </div>
      <div class="cart-notification__links">
        <div style="display:none; opacity:0; pointer-events:none;">
          <a href="{{ routes.cart_url }}" id="cart-notification-button" class="button button--full-width"></a>
        </div>
        <form action="{{ routes.cart_url }}" method="post" id="cart">
          <button class="
            theme-button theme-button-wide theme-button-bg-black theme-button-color-white
            theme-button-border-black theme-button-hover-bg-white theme-button-hover-color-black
            theme-button-hover-border-black" name="checkout" form="cart">{{ 'sections.cart.checkout' | t }}</button>
        </form>
        <div style="display:none; opacity:0; pointer-events:none;">
          <button type="button" class="link button-label">{{ 'general.continue_shopping' | t }}</button>
        </div>
      </div>
    </div>
  </div>
</cart-notification>