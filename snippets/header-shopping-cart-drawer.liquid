{%- liquid
  assign filename = 'header-shopping-cart-drawer'
  assign settings_routes_cart_vs_checkout_name = 'additional.checkout_button.label' | t
  assign settings_routes_cart_vs_checkout_url = settings.settings_routes_cart_vs_checkout_url
  if settings_routes_cart_vs_checkout_url == 'goto_checkout'
    assign settings_routes_cart_vs_checkout_final_url = '/checkout'
  else
    assign settings_routes_cart_vs_checkout_final_url = routes.cart_url
  endif
  assign use_additional_products = 'true'

  if use_additional_products == 'true'
    assign this_collection = collections['shopping-cart-drawer']
    assign additional_products_size = this_collection.all_products_count | plus : 0
    if additional_products_size < 1    
      assign this_collection = collections['all-products']
    endif 
    assign additional_products_size = this_collection.all_products_count | plus : 0
    if additional_products_size < 1
      assign use_additional_products = 'false'
    endif
  endif

  assign current_market = localization.market.handle
  assign shipping_free_min_order = ''
  assign show_free_min_order = false
  if current_market == 'nl'
    assign show_free_min_order = true
    assign shipping_free_min_order = settings.website_free_shipping_nl | plus : 0 | times : 100
  elsif  current_market == 'be'
    assign show_free_min_order = true
    assign shipping_free_min_order = settings.website_free_shipping_be | plus : 0 | times : 100
  endif

  assign cart_total_price = cart.total_price 
  assign cart_total_price_money = cart_total_price | money | replace : ',00',',-'
-%}
{%- liquid
  assign spend_more_free_shipping = 0
  if cart.item_count > 0
    if shipping_free_min_order > 0
      if cart_total_price < shipping_free_min_order
        assign spend_more_free_shipping = shipping_free_min_order | minus : cart_total_price
      endif
      assign spend_more_free_shipping_money = spend_more_free_shipping | money | replace : ',00',',-'
    endif
  endif
-%}
{%- if show_free_min_order == true -%}
  {%- capture spend_more_free_shipping_html -%}
    <div class="sc-extra-spend-more-wrapper js-ajax-loaded-content">
      {%- if spend_more_free_shipping > 0 -%}
        <div class="sc-divider sc-divider-c margin-t-xxs"></div>
        <h3 class="font-fam-light font-size-sm color-black -txt-uppercase padding-v-xxs">{{ 'sections.cart.spend_more_title_left' | t | replace : '[MONEY]', spend_more_free_shipping_money }}</h3>
      {%- elsif cart.item_count > 0 -%}
        <div class="sc-divider sc-divider-c margin-t-xxs"></div>
        <h3 class="font-fam-light font-size-sm color-black -txt-uppercase padding-v-xxs">{{ 'sections.cart.spend_more_title_reached' | t | replace : '[MONEY]', spend_more_free_shipping_money }}</h3>
      {%- endif -%}
    </div>
  {%- endcapture -%}
{%- endif -%}

{%- if use_additional_products == 'true' -%}
  {%- capture additional_products_html -%}
    <div class="sc-wrapper padding-t-xxs">
      <div class="sc-divider sc-divider-c"></div>
      <div class="sc-extra-products-wrapper sc-drawer-shuffle-products padding-t-xxs">
        <h3 class="font-fam-bold font-size-sm txt-uppercase color-black">{{ 'sections.cart.extra_prod_title' | t }}</h3>
        <div class="sc-extra-products padding-t-3xs">
          {%- liquid
            assign number_to_show = 5
            assign number_to_fetch = 20
          -%}
          {%- capture this_products_html -%}
            {%- for product in this_collection.products limit: number_to_show -%}
              {%- assign product_id = product.variants.first.id -%}
              <div class="grid__item nomargin mousepointer" id="product-{{ product_id }}">
                {%- liquid 
                  assign chosen_product_card_layout = 'hor'
                  render 'product-card', collection:this_collection, chosen_product_card_layout:chosen_product_card_layout, product_card_product:product, button_size:'small', area_name:area_name, product_card_color:product_card_color
                -%}
              </div>
            {%- endfor -%}
          {%- endcapture -%}
          {%- capture this_products_html_extra -%}
            {%- for product in this_collection.products limit: number_to_fetch -%}
              {%- assign product_id = product.variants.first.id -%}
              <div class="li grid__item nomargin mousepointer" id="product-{{ product_id }}">
                {%- liquid 
                  assign chosen_product_card_layout = 'hor'
                  render 'product-card', collection:this_collection, chosen_product_card_layout:chosen_product_card_layout, product_card_product:product, button_size:'small', area_name:area_name, product_card_color:product_card_color
                -%}            </div>
            {%- endfor -%}
          {%- endcapture -%}

          {%- liquid
            echo '<div data-show="[number_to_show]" id="collection-product-cart-add-ons" class="collection-grid element-count-[number_to_show] list-unstyled">' | replace : '[number_to_show]', number_to_show
            render'inline-html',input_html:this_products_html
            echo '</div>'
            echo '<div data-show="[number_to_show]" id="collection-product-cart-add-ons-extra" class="collection-grid element-count-[number_to_show] list-unstyled">' | replace : '[number_to_show]', number_to_show
            render'inline-html',input_html:this_products_html_extra
            echo '</div>'
          -%}
          <style>#collection-product-cart-add-ons-extra{display:none}</style>
        </div>
      </div>
    </div>
  {%- endcapture -%}
{%- endif -%}
<div class="shopping-cart">
  <div class="sc-inner">
    <div class="sc-section-top padding-t-xxs">
      <div class="sc-title-wrapper">
        <div class="sc-title"><h2 id="cart-title" class="font-fam-special font-size-lg color-black">{{ 'sections.cart.title' | t }}</h2></div>
        <div class="sc-close js-close-sc">{%- render 'theme-icon', icon: 'icon-close' -%}</div>
      </div>
      <div class="sc-divider sc-divider-a margin-v-xxs"></div>
    </div>
    <div class="sc-section-middle theme-f-vert theme-f-outside">
      <div class="sc-prod-items js-ajax-loaded-content" data-cart-items="{{ cart.item_count }}">

        {% comment %}
          <div class="sc-cart-items bg_green" data-cart-items="{{ cart.item_count }}">
            {%- for item in cart.items -%}
              {%- liquid
                assign product_title = item.product.title | escape
                assign this_product_id = item.product.id | escape
                assign this_product_variant_id = item.id
                assign this_product_key = item.key
              -%}
              <div class="sc-cart-item" id="sc-cart-{{ this_product_variant_id }}" data-prod-id="{{ this_product_variant_id }}" data-prod-key="{{ this_product_key }}">
                <div class="sc-cart-item__details gl-p-b-2xs">
                  <div class="gl-f-hor gl-g-3xs gl-f-outside gl-w-100">
                    <div class="sc-cart-item__media">
                      <a href="{{ item.product.url }}" alt="{{ product_title }}" class="bg-product-bg">
                        {%- if item.image -%}
                          {%- liquid
                            assign product_image_a = item.image
                            assign product_image_a_alt = product_image_a.alt                  
                          -%}
                          <div class="gl-r-prod">
                            <img style="position:absolute;" class="sc-cart-item__image" src="{{ item.image | img_url: '200x' }}" alt="{{ item.image.alt | escape }}" loading="lazy" width="80" height="{{ 80 | divided_by: item.image.aspect_ratio | ceil }}">

                          </div>
                        {%- endif -%}
                      </a>
                    </div>            
                    <div class="gl-f-vert gl-f-outside" style="flex:auto">
                      <div class="gl-f-vert gl-g-6xs">
                        <a href="{{ item.product.url }}" alt="{{ product_title }}" class="full-unstyled-link sc-cart-item__name break">
                          <h5 class="gl-ff-bold gl-fs-sm gl-c-black">{{ product_title }}</h5>
                        </a>
                        <h6 class="gl-ff-light gl-fs-sm gl-c-black gl-hidden">{{ product_vendor | escape }}</h6>
                        <div class="gl-ff-light gl-fs-sm">
                          {%- render 'cart-product-variant-details',item:item,version:'drawer' -%}    
                        </div>
                      </div>
                      <div class="gl-f-hor gl-f-outside">
                        <div class="sc-cart-item__price-wrapper">
                          <span class="price price--end gl-ff-bold gl-fs-sm gl-c-black">
                            {{ item.price | money | replace: ',00',product_price__replace_zeros_width }}
                          </span>
                        </div>
                        {%- if quantity_dropdown_vs_other == 'dropdown' -%}
                          {%- liquid
                            assign total_elements = 5
                            assign total_elements_half = 3
                            assign current_qty = item.quantity
                            assign start_qty = current_qty | minus : total_elements_half
                            if start_qty < 1 
                              assign start_qty = 1
                            endif
                            assign end_qty = start_qty | plus : total_elements
                          -%}
                          <div class="gl-ff-bold gl-fs-xs txt-uppercase">
                            <div class="sc-quantity__select gl-f-hor" style="position:relative;">
                            <span class="gl-f-vert gl-f-middle gl-fs-md gl-c-dgrey" style="padding-top:2px">x&nbsp;</span>
                            <select size="1" class="js-quantity__select js-quantity__select-inactive">
                              {%- liquid
                                capture qty_selecter
                                  assign inventory_quantity = item.variant.inventory_quantity                 
                                  for i in (start_qty..end_qty)
                                    echo '<option value="[I]" ' | replace : '[I]', i
                                    if current_qty == i
                                      echo ' selected'
                                    endif
                                    if i > inventory_quantity
                                      echo ' disabled'
                                    endif
                                    echo '>[I]</option>' | replace : '[I]', i
                                  endfor
                                endcapture
                                echo qty_selecter
                              -%}
                            </select>
                            <span class="i"></span>
                            </div>
                          </div>
                        {%- else -%}
                          <quantity-input class="quantity quantity-input gl-bg-red">
                            <button class="quantity__button js-quantity-button-min-inactive no-js-hidden" name="minus" type="button">
                              <span class="visually-hidden">{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}</span>
                              {%- render 'theme-icon', icon: 'icon-minus' %}
                            </button>
                            <input class="quantity__input js-quantity__input-inactive" type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}" id="Quantity-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}">
                            <button class="quantity__button js-quantity-button-plus-inactive no-js-hidden" name="plus" type="button">
                              <span class="visually-hidden">{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}</span>
                              {%- render 'theme-icon', icon: 'icon-plus' %}
                            </button>
                          </quantity-input>
                        {%- endif -%}                 
                      </div>
                    </div>
                    <div class="sc-cart-item__quantity gl-f-vert gl-f-outside gl-f-right">
                      <div class="gl-p-t-7xs">
                        <mini-cart-remove-button class="cart-remove-button js-cart-remove-button-inactive" id="Remove-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}">
                          <div class="gl-ff-bold gl-fs-xs txt-uppercase underlined-link mousepointer">
                            <span>{{ 'sections.cart.remove_prod' | t }}</span>
                          </div>
                        </mini-cart-remove-button>
                      </div>                
                      <div class="sc-cart-item__price-wrapper">
                        <span class="price price--end gl-ff-bold gl-fs-sm gl-c-black">
                          {{ item.original_line_price | money | replace: ',00',product_price__replace_zeros_width }}
                        </span>
                      </div>
                    </div>              
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        {% endcomment %}

        {%- if cart.item_count > 0 -%}
          <table class="sc-cart-items" data-cart-items="{{ cart.item_count }}" cellpadding="0" cellspacing="0">
            <tbody>
            {%- for item in cart.items -%}
              {%- liquid
                assign product_title = item.product.title | escape
                assign this_product_id = item.product.id | escape
                assign this_product_variant_id = item.id
                assign this_product_key = item.key
              -%}
              {%- liquid
                capture product_quantity_variant
                  render 'cart-product-variant-details',item:item,version:'drawer'
                endcapture
              -%}

              <tr class="sc-cart-item" id="sc-cart-{{ this_product_variant_id }}" data-prod-line="{{ item.index | plus: 1 }}" data-prod-id="{{ this_product_variant_id }}" data-prod-key="{{ this_product_key }}">
                <td class="sc-cart-item__media">
                  <a href="{{ item.product.url }}" style="aspect-ratio:1/1;" alt="{{ product_title }}" class="bg-product-bg">
                    {%- if item.image -%}
                      <img style="position:absolute;" class="sc-cart-item__image" src="{{ item.image | img_url: '200x' }}" alt="{{ item.image.alt | escape }}" loading="lazy" width="80" height="{{ 80 | divided_by: item.image.aspect_ratio | ceil }}">
                    {%- endif -%}
                  </a>
                </td>
                <td class="sc-cart-item__details padding-l-10 padding-b-xs">
                  <a href="{{ item.product.url }}" alt="{{ product_title }}" class="full-unstyled-link sc-cart-item__name break">
                    {%- liquid
                      assign split_value = ' - '
                      if product_title contains split_value
                        assign product_title_array = product_title | split : split_value
                        assign product_title_a = product_title_array[0]
                        assign product_title_b = product_title_array[1]
                        echo '<h5 class="font-fam-normal font-size-3xs txt-lowercase color-black">[T]</h5>' | replace: '[T]', product_title_a
                        echo '<h6 class="font-fam-normal font-size-xs txt-lowercase color-black">[T]</h6>' | replace: '[T]', product_title_b
                      else 
                        echo '<h5 class="font-fam-bold font-size-xs txt-lowercase color-black">[T]</h5>' | replace: '[T]', product_title 
                      endif
                      comment
                        echo '<h4 class="font-fam-normal font-size-xxs txt-lowercase color-black">[T]</h4>' | replace: '[T]', product_quantity_variant
                      endcomment
                    -%}   
                  </a>          

                </td>
                <td class="sc-cart-item__quantity">
                  <mini-cart-remove-button class="cart-remove-button js-cart-remove-button-inactive" id="Remove-{{ item.index | plus: 1 }}"  data-index="{{ item.index | plus: 1 }}">
                    <div aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}">
                      {% render 'theme-icon', icon: 'icon-remove' %}
                    </div>
                  </mini-cart-remove-button>
                  <quantity-input class="quantity quantity-input">
                    <button class="quantity__button js-quantity-button-min-inactive no-js-hidden" name="minus" type="button">
                      <span class="visually-hidden">{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}</span>
                      {% render 'theme-icon', icon: 'icon-minus' %}
                    </button>
                    <input class="quantity__input js-quantity__input-inactive" type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}" id="Quantity-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}">
                    <button class="quantity__button js-quantity-button-plus-inactive no-js-hidden" name="plus" type="button">
                      <span class="visually-hidden">{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}</span>
                      {% render 'theme-icon', icon: 'icon-plus' %}
                    </button>
                  </quantity-input>
                </td>
                <td class="sc-cart-item__totals right padding-r-xxs">
                  <div class="sc-cart-item__price-wrapper medium-up" data-lp="{{ item.line_price }}" data-op="{{ item.original_line_price }}">
                    {%- if item.line_price < item.original_line_price -%}
                      <span style="text-decoration:line-through" class="price price--end font-fam-normal font-size-3xs txt-uppercase color-grey">{{ item.original_line_price | money | replace : ',00',',-' }}</span>
                      <span class="price price--end font-fam-bold font-size-xs txt-uppercase color-black">{{ item.line_price | money | replace : ',00',',-' }}</span>
                    {%- else -%}
                      <span class="price price--end font-fam-bold font-size-xs txt-uppercase color-black">{{ item.original_line_price | money | replace : ',00',',-' }}</span>
                    {%- endif -%}
                  </div>
                </td>
              </tr>
            {%- endfor -%}
            </tbody>
          </table>
        {%- endif -%}


          {%- if cart.item_count == 0 -%}
            <div class="cart-empty-alert"><h5 class="font-fam-bold font-size-sm color-black ">{{ 'sections.cart.cart_empty' | t }}</h5></div>
          {%- else -%}
            <div class="cart-empty-alert visually-hidden"><h5 class="font-fam-bold font-size-sm color-black ">{{ 'sections.cart.cart_empty' | t }}</h5></div>
          {%- endif -%} 

          {{ spend_more_free_shipping_html }}
          <div class="cart-empty-alert visually-hidden"><h5 class="font-fam-light font-size-sm color-black txt-uppercase">{{ 'sections.cart.cart_empty' | t }}</h5></div>
          <input type="hidden" value="{{ 'sections.cart.sure_delete_alert' | t }}" class="sure_delete_alert">
          <input type="hidden" value="{{ 'sections.cart.sure_delete_alert_yes' | t }}" class="sure_delete_alert_yes">
          <input type="hidden" value="{{ 'sections.cart.sure_delete_alert_no' | t }}" class="sure_delete_alert_no">
          <input type="hidden" value="{{ cart.item_count }}" class="total_prod_items_in_cart">
        </div>
        
        {{ additional_products_html }}
    </div>
    <div class="sc-section-bottom padding-b-3xs">
      <div class="sc-divider sc-divider-b margin-t-xxs margin-b-xxs"></div>
      <div class="sc-totals margin-b-xxs font-size-sm">
        <div class="sc-totals-desc">
          {%- liquid
            assign estimated_total_title = 'sections.cart.estimated_total_title' | t  | replace : '[break]', '<br>'
            assign estimated_total_text = 'sections.cart.estimated_total_text' | t  | replace : '[break]', '<br>'
          -%}
          <p class="font-fam-bold font-size-xs txt-uppercase color-black">{{ estimated_total_title }}</p>
          <p class="font-fam-light font-size-4xs --txt-uppercase color-grey">{{ estimated_total_text }}</p>
        </div>
        <div class="sc-totals-total js-ajax-loaded-content padding-l-m">
          <span class="font-fam-bold font-size-md color-black">{{ cart_total_price_money }}</span>
        </div>
      </div>
      <div class="sc-checkout-buttons margin-b-3xs" style="column-gap:1rem;row-gap:1rem;">
        <div class="button-checkout" style="flex:1;">
          <a href="{{ settings_routes_cart_vs_checkout_final_url }}" style="width:100%;" class="button-checkout theme-button theme-button__round-medium theme-button__white-white-red theme-button-hover__blue-grey-blue">
            <span>{{ settings_routes_cart_vs_checkout_name }}</span>
          </a>
        </div>
        <div class="button-continue">
          <span class="js-close-sc theme-button theme-button__round-medium theme-button__white-black-white theme-button-hover__blue-grey-blue">
            <span>{{ 'sections.cart.continue_shopping' | t }}</span>
          </span>
        </div>
      </div>
      <div class="sc-checkout-payment margin-b-xxs theme-w-100">
        <div class="theme-f-hor theme-w-100 theme-f-center theme-g-6xs theme-payment-icons --no-pe">
          <div class="icon icon-payment">

            <svg class="icon icon--full-color" viewBox="0 0 620 248" fill="none" xmlns="http://www.w3.org/2000/svg">
              <title>iDeal/Wero</title>
