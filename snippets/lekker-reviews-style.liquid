{%- comment -%} Opmaak van het reviewblok, hoort bij lekker-reviews (CRO-project 1.4, november 2026). {%- endcomment -%}
<style>
    .shopify-section[id$="__theme_section_review_app"] > .shopify-app-block, .shopify-section[id$="__173230878117298f18"] > .shopify-app-block { display: none; }
    .shopify-section.lk-rev-fallback > .shopify-app-block, .shopify-section.lk-rev-writing > .shopify-app-block { display: block; }
    .lk-rev-writing .jdgm-rev-widg > *:not(.jdgm-rev-widg__header), .lk-rev-writing .jdgm-rev-widg__header > *:not(.jdgm-form-wrapper):not(.jdgm-form-dynamic-wrapper) { display: none !important; }
    [id*="judge_me_reviews_preview_badge"] .jdgm-preview-badge { display: none !important; }
    .lk-rev-badge { display: inline-block; cursor: pointer; }
    .lk-rev-badge .jdgm-prev-badge { display: inline-flex !important; align-items: center; gap: 6px; }
    .lk-rev { display: none; max-width: 1200px; margin: 0 auto; padding: 40px 20px; color: var(--color-black); line-height: 1.45; }
    .lk-rev.is-placed { display: block; }
    .lk-rev__head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 40px; margin-bottom: 24px; }
    .lk-rev__title { margin: 0 0 8px; color: var(--color-red); }
    .lk-rev__score { display: flex; align-items: center; gap: 12px; }
    .lk-rev__avg { font-size: 44px; line-height: 1; font-weight: 700; color: var(--color-red); }
    .lk-rev__stars { display: inline-flex; gap: 2px; vertical-align: middle; }
    .lk-rev__stars svg { width: 18px; height: 18px; display: block; }
    .lk-rev__based { margin: 4px 0 0; font-size: 14px; }
    .lk-rev__bars { list-style: none; margin: 0; padding: 0; min-width: 220px; flex: 0 1 300px; }
    .lk-rev__bar { display: flex; align-items: center; gap: 8px; font-size: 13px; line-height: 1.8; margin: 0; }
    .lk-rev__bar-track { flex: 1; height: 8px; border-radius: 800px; background: var(--color-white); overflow: hidden; }
    .lk-rev__bar-fill { height: 100%; border-radius: 800px; background: var(--color-red); }
    .lk-rev__bar-n { width: 24px; text-align: right; }
    .lk-rev__write { border: 1px solid var(--color-red); border-radius: 800px; padding: 10px 20px; background: var(--color-white); color: var(--color-red); font: inherit; font-size: 14px; line-height: 1.3; cursor: pointer; }
    .lk-rev__tools { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
    .lk-rev__chips { display: flex; flex-wrap: wrap; gap: 8px; }
    .lk-rev__chip { border: 1px solid var(--color-red); border-radius: 800px; padding: 6px 14px; background: var(--color-white); color: var(--color-red); font: inherit; font-size: 14px; line-height: 1.3; text-transform: lowercase; cursor: pointer; }
    .lk-rev__chip.is-active { background: var(--color-red); color: var(--color-white); }
    .lk-rev__sort { border: 1px solid rgba(33, 35, 34, .2); border-radius: 800px; padding: 6px 14px; background: var(--color-white); color: var(--color-black); font: inherit; font-size: 14px; line-height: 1.3; }
    .lk-rev__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
    .lk-rev__item { padding: 18px 20px; border-radius: 16px; background: var(--color-white); }
    .lk-rev__meta { line-height: 1.4; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; font-size: 13px; }
    .lk-rev__author { font-weight: 700; }
    .lk-rev__verified { color: var(--color-green); }
    .lk-rev__date { opacity: .7; }
    .lk-rev__scent { margin-left: auto; padding: 2px 10px; border-radius: 800px; background: var(--color-lblue); line-height: 1.4; text-transform: lowercase; }
    .lk-rev__rtitle { margin: 10px 0 4px; font-size: 15px; font-weight: 700; }
    .lk-rev__body { font-size: 15px; line-height: 1.5; }
    .lk-rev__body p { margin: 6px 0 0; }
    .lk-rev__pics { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
    .lk-rev__pics img { width: 72px; height: 72px; border-radius: 10px; object-fit: cover; display: block; }
    .lk-rev__reply { margin-top: 12px; padding: 10px 14px; border-radius: 12px; background: var(--color-lgrey); font-size: 14px; }
    .lk-rev__reply strong { display: block; margin-bottom: 2px; }
    .lk-rev__more { display: block; margin: 20px auto 0; border: 0; border-radius: 800px; padding: 12px 24px; background: var(--color-red); color: var(--color-white); font: inherit; font-size: 15px; line-height: 1.3; cursor: pointer; }
    .lk-rev__more[hidden] { display: none; }
    @media screen and (max-width: 767px) {
      .lk-rev { padding: 32px 20px; }
      .lk-rev__head { flex-direction: column; align-items: stretch; }
      .lk-rev__bars { flex-basis: auto; }
      .lk-rev__tools { flex-direction: column; align-items: stretch; }
      .lk-rev__chips { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
      .lk-rev__chip { flex: 0 0 auto; }
    }
</style>