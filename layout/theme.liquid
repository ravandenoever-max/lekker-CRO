{%- endcapture -%}
{%- render'inline-html', input_html : html_head_content -%}
<body id="page-{{ body_id }}" class="{{ body_classes }}">
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MQGDQJ8C" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  {%- if website_use_loader == 'true' -%}{%- render 'pre-loader' -%}{%- endif -%}
  <a class="skip-to-content-link button visually-hidden" href="#main_content">{{ "accessibility.skip_to_text" | t }}</a>
  {%- liquid  
    capture html_content
      section 'element-announcement-bar'
      section 'element-header-theme'
      if website_use_shopping_cart_drawer == 'true'
        render 'header-cart-drawer'
      endif
      if use_mobile_menu_foldable == 'true'
        assign menu_a = linklists.main-mega-menu-left
        assign menu_b = linklists.main-mega-menu-right
        assign menu_extra = linklists.mobile-sub-menu
        if menu_a.size > 0 or  menu_b.size > 0
          render 'header-foldable-menu', menu_a:menu_a,menu_b:menu_b,menu_extra:menu_extra,current_language:current_language
        endif
      endif 
    endcapture
    render'inline-html', input_html : html_content 

    echo '<main id="main_content" class="margin-t-header content-for-layout focus-none[EXTRAMAINCLASSES]" role="main" tabindex="-1">' | replace :'[EXTRAMAINCLASSES]', extra_main_classes
      echo content_for_layout
    echo '</main>'

    capture html_content
      section 'element-footer-theme'
      if website_use_cookie_alert == 'true'
        render 'cookie-alert'
      endif
      if website_use_shopping_cart_alert == 'true' and request_page_type != 'cart'
        render 'header-cart-alert'
      endif
      if website_use_newsletter_popup == 'true'
        render 'newsletter-alert'
      endif
    endcapture
    render'inline-html', input_html : html_content 
  -%}
  {%- capture html_content -%}
    {%- if use_desktop_submenu_menu_mega == 'true' -%}
      <div class="js-hide-below-768 main-menu__underlay no-se"></div>
      <div class="js-hide-below-768 main-menu__background no-pe no-se"></div>
    {%- endif -%}    
    <div class="visually-hidden">
      <input type="hidden" class="js-website-shop-name" value="{{ shop.name | escape }}">
      <input type="hidden" class="js-website-windoww" value="375">
      <input type="hidden" class="js-website-url" value="{{ shop.url }}">
      <input type="hidden" class="js-website-asset-url" value="{{ current_asset_url_string }}">
      <input type="hidden" class="js-website-use-loader" value="{{ website_use_loader }}">
      <input type="hidden" class="js-website-use-desktop-submenu-menu-mega" value="{{ use_desktop_submenu_menu_mega }}">
      <input type="hidden" class="js-website-use-desktop-submenu-foldable" value="{{ use_desktop_submenu_foldable }}">    
      <input type="hidden" class="js-website-use-mobile-menu-foldable" value="{{ use_mobile_menu_foldable }}">      
      <input type="hidden" class="js-website-use-shopping-cart-drawer" value="{{ website_use_shopping_cart_drawer}}">
      <input type="hidden" class="js-website-use-shopping-cart-drawer-remove" value="{{ website_use_shopping_cart_drawer__remove_button }}">
      <input type="hidden" class="js-website-use-shopping-cart-mini" value="{{ website_use_shopping_cart_mini }}">
      <input type="hidden" class="js-website-use-shopping-cart-alert" value="{{ website_use_shopping_cart_alert }}">
      <input type="hidden" class="js-website-use-newsletter-popup" value="{{ website_use_newsletter_popup }}">
      <input type="hidden" class="js-website-use-newsletter-popup-page-count" value="{{ website_use_newsletter_popup_page_count }}">
      <input type="hidden" class="js-website-use-cookie-alert" value="{{ website_use_cookie_alert }}">
      <input type="hidden" class="js-website-use-animations" value="{{ settings.website_use_animations }}">
      <input type="hidden" class="js-website-location-search" value="{{ settings.website_location_search }}">
      <input type="hidden" class="js-website-language-switch-title" value="{{ 'additional.language_switch.title' | t }}">
      <input type="hidden" class="js-website-language-switch-message" value="{{ 'additional.language_switch.message' | t }}">
      <input type="hidden" class="js-website-language-switch-agree" value="{{ 'additional.language_switch.agree' | t }}">
      <input type="hidden" class="js-website-language-switch-disagree" value="{{ 'additional.language_switch.disagree' | t }}">
      {%- if settings.gtm_tag != blank -%}<input type="hidden" class="js-website-gtm-tag" value="{{ settings.gtm_tag }}">{%- endif -%}
      {%- if settings.ga_tag != blank -%}<input type="hidden" class="js-website-ga-tag" value="{{ settings.ga_tag }}">{%- endif -%}
      {%- liquid
        assign number_to_show = 5
        assign collection_handle = 'all-products'
        assign products_string_backup = ''
        for product in collections[collection_handle].products limit: number_to_show
          if product.available == true
            assign products_string_backup = products_string_backup | append : product.id
            assign products_string_backup = products_string_backup | append : '='
            assign products_string_backup = products_string_backup | append : product.handle
            assign products_string_backup = products_string_backup | append : ':::'
          endif
        endfor
      -%}
      <input type="hidden" class="js-website-recently-product-string-backup" value="{{ products_string_backup }}">
      {%- if template contains 'product' -%}
      <input type="hidden" class="js-website-product-handle" value="{{ product.id }}={{ product.handle }}">
      {%- endif -%}
      <ul><li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li></ul>
    </div>
    {%- render 'switch-language', given_version: 'noscript-only', current_language: current_language -%}

    <script src="{{ 'theme-animations.min.js' | asset_url }}" type="text/javascript"></script>
    <script class="js-lazy-load-script" data-script-delay="1000" data-script-src="{{ 'svg-inject.min.js' | asset_url }}" defer="defer" type="text/javascript"></script>
    <script class="--js-lazy-load-script" data-script-delay="3000" data-script-src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" async type="text/javascript"></script>
  {%- endcapture %}
  {%- render'inline-html', input_html : html_content -%}

  {%- if print_products_data_json_in_console -%}
    {%- assign number_to_show = 200 -%}
    {%- for collection in collections -%}
      <script>console.log('Collection : {{ collection | json }} ');</script>
      {%- assign collection_title = collection.title -%}
      {%- for product in collection.products limit: number_to_show -%}
        <script>console.log('COL: {{ collection_title }} > Product : {{ product | json }} ');</script>
      {%- endfor -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if website_use_newsletter_popup == 'true' -%}
    <script>window.newsletter_cookie_name = 'store-newsletter-popup-check';
    {%- if form.posted_successfully? -%}
      var cookie_name = window.newsletter_cookie_name; SetCookie(cookie_name,'7000','short');
    {%- endif -%}
    </script>
  {%- endif -%}
  {%- capture bloated_css -%}
    <style> @media (max-width:549px){.shopify-block.shopify-app-block{width:calc(100vw - 40px);max-width:100%;padding:0;margin:0 20px}body.bp-xxs .col-xxs-padding-b-4{padding-bottom:4px !important}}.jdgm-prev-badge__stars{margin-right:8px} </style>
  {%- endcapture -%}
  {%- capture bloated_css -%}
    <style>
      .card-wrapper-flex.card-wrapper-hor{display:flex;display:-webkit-box;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-box-orient:horizontal;-webkit-box-direction:normal;-webkit-flex-direction:row;-ms-flex-direction:row;flex-direction:row;grid-column-gap:var(--spacing-xxs) !important;grid-row-gap:var(--spacing-xxs) !important;}
      .card-wrapper-flex.card-wrapper-hor .card-wrapper-flex__button{display:flex;display:-webkit-box;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-box-orient:vertical;-webkit-box-direction:normal;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;    }
      .card-wrapper-flex.card-wrapper-hor .card-wrapper-flex__button .card-information{display:flex;flex-direction:column;align-content:flex-start;align-items:flex-start;}
      .card-wrapper-flex.card-wrapper-hor .card-wrapper-flex__button .card-information .card-information__title{text-align:left;margin-bottom:0}
      .card-wrapper-flex.card-wrapper-hor .card-wrapper-flex__title {flex:0;padding-bottom:0.5rem;}
      .card-wrapper-flex.card-wrapper-hor .card-wrapper-inner,
      .card-wrapper-flex.card-wrapper-hor .card-wrapper-inner .card-wrapper-hover-image, 
      .card-wrapper-flex.card-wrapper-hor .card-wrapper-inner .card-wrapper-flex__media{width:120px;height:120px}
