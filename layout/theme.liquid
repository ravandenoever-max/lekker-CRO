  {%- comment -%}{{ content_for_header }} needed for liquid to be able to be saved {%- endcomment -%}
  {{- content_for_header_fetched }}
  {%- render 'style-root', menu_css_main_menu_file: menu_css_main_menu_file, menu_css_mobile_menu_file: menu_css_mobile_menu_file -%}
  <link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_url }}"><link id="favicon-32" rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32x32.png' | asset_url }}"><link id="favicon-16" rel="icon" type="image/png" sizes="16x16" href="{{ 'favicon-16x16.png' | asset_url }}"><link rel="manifest" href="{{ 'site.webmanifest' | asset_url }}"><link rel="mask-icon" href="{{ 'safari-pinned-tab.svg' | asset_url }}" color="#5bbad5"><meta name="msapplication-TileColor" content="#da532c"><meta name="theme-color" content="#ffffff"><link id="favicon" rel="icon" type="image/x-icon" href="{{ 'favicon-frame-01.png' | asset_url }}">
