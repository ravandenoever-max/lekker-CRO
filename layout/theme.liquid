{%- liquid

  if template == 'collection'
    if collection.handle == '----all-products'
      echo '<script> window.location.replace("/"); </script>'
    elsif collection.handle == 'shopping-cart-addons'
      echo '<script> window.location.replace("/"); </script>'
    endif
  endif

  assign request_page_type = request.page_type
  assign request_path = request.path
  assign check_forbidden_page = 'false'

  if template == 'index' and request_path == '/shop'
    assign check_forbidden_page = 'true'
    echo '<script> cl("Page hidden"); </script>'
  endif

  if template == 'collection'
    assign dont_show_collection_handle_array = settings.dont_show_collection_handle | split:"::"
    if dont_show_collection_handle_array contains collection.handle
      assign check_forbidden_page = 'true'
      echo '<script> cl("Collection hidden"); </script>'
    endif    
  endif

  assign dont_show_pages_handle_array = settings.dont_show_pages_handle | split:"::" 
  if dont_show_pages_handle_array contains request_path
    assign check_forbidden_page = 'true'
    echo '<script> cl("request_page_type != page && request_path hidden"); </script>'
  endif
  if check_forbidden_page == 'true'
    echo '<script> cl("[theme.liquid] Redirect"); </script>'
    echo '<script id="fbp"> window.location.replace("/"); </script>'
    break
  endif  

  assign print_products_data_json_in_console = false
  assign theme_footer_template = 'theme'
  assign request_page_type = request.page_type
  assign show_product_prizes = 'true'
  assign content_for_header_fetched = content_for_header
  assign content_for_header_fetched = content_for_header_fetched | replace : "Dawn", shop.name

  if show_product_prizes != 'true'
    if request_page_type == 'product'
      assign this_product_price = product.price
      assign this_product_price_without_currency = product.price | money_without_currency | replace : ",", "."
      assign this_product_price_hidden = "0.00"
      assign content_for_header_fetched = content_for_header_fetched | replace : this_product_price, this_product_price_hidden
      assign content_for_header_fetched = content_for_header_fetched | replace : this_product_price_without_currency, this_product_price_hidden
    endif
  endif
  assign content_for_header_fetched = content_for_header_fetched | strip_newlines
-%}

{%- if request_page_type == 'product' and request.path contains '/product-card' -%}
  {%- liquid
    comment
      request.params.cardtype doenst work at the moment.
      used for featured collections
    endcomment
    echo request.params.cardtype
    assign product_id = product.variants.first.id
    if request.params.cardtype != blank
      assign chosen_product_card_layout = 'circle'
    else
      assign chosen_product_card_layout = 'xxl'
    endif
    capture product_card
    echo '<li class="grid__item nomargin" id="product-[PID]">' | replace : '[PID]' ,product_id
    render 'product-card', chosen_product_card_layout:chosen_product_card_layout, product_card_product:product, button_size:'small'
    echo '</li>'
    endcapture
    echo product_card

  -%}
{%- elsif request_page_type == 'collection' and request.path contains '/shopping-cart-drawer'-%}
  {%- render 'header-shopping-cart-drawer'-%}
{%- else-%}
{%- liquid
  if settings.use_shopping_cart_mini == true
    assign website_use_shopping_cart_mini = 'true'
  else
    assign website_use_shopping_cart_mini = 'false'
  endif
  if settings.use_shopping_cart_alert == true
    assign website_use_shopping_cart_alert = 'true'
  else
    assign website_use_shopping_cart_alert = 'false'
  endif
  if settings.use_animations == true
    assign website_use_animations = 'true'
  else
    assign website_use_animations = 'false'
  endif
  if settings.use_newsletter_popup == true
    assign website_use_newsletter_popup = 'true'
    if customer
      for tag in customer.tags
        if tag contains "newsletter-popup"
          assign website_use_newsletter_popup = 'false'
        endif
      endfor
    endif
  else
    assign website_use_newsletter_popup = 'false'
  endif
  assign website_use_newsletter_popup_page_count = settings.use_newsletter_popup_page_count

  if settings.use_shopping_cart_drawer == true
    assign website_use_shopping_cart_drawer = 'true'
  else
    assign website_use_shopping_cart_drawer = 'false'
  endif
  assign website_use_shopping_cart_drawer__remove_button = 'inline'

  if settings.website_use_cookie_alert == true
    assign website_use_cookie_alert = 'true'
  else
    assign website_use_cookie_alert = 'false'
  endif

  if settings.website_use_loader == true
    assign website_use_loader = 'true'
  else
    assign website_use_loader = 'false'
  endif

  if settings.desktop_submenu_version != 'none'
    assign menu_css_main_menu_file = 'theme-menu-' | append: settings.desktop_submenu_version
    assign menu_css_main_menu_file = menu_css_main_menu_file | append: '.css'
  else
    assign menu_css_main_menu_file = 'none'
  endif
  assign menu_css_mobile_menu_file = 'theme-menu-' | append: settings.mobile_menu_version
  assign menu_css_mobile_menu_file = menu_css_mobile_menu_file | append: '-mobile.css'

  assign shop_name = shop.name | capitalize

  assign page_title_seperator = ' - '
  assign page_title_add_shop_name = true
  assign page_title_product_add_collection = true
  assign page_title_product_automated = false

  if template == 'blog' and blog.title != blank
      assign page_title = blog.title

  elsif template contains 'page.' and page.title != blank
      assign page_title = page.title

  elsif template contains 'customers/'
      if template == 'customers/login'
        assign page_title = 'Login'
      elsif template == 'customers/register'
        assign page_title = 'Create account'
      endif

  elsif template == 'product' and product.title != blank
      assign collection_title = collection.title | capitalize
      if automated_product_page_title == true
          assign product_title = product.title | capitalize
          assign product_title = product.title | escape
          assign product_meta = product.metafields.my_fields

          if collection.title != blank and page_title_product_add_collection == true
            assign page_title = product_title | append : page_title_seperator | append : collection_title
          else
            assign page_title = product_title
          endif
      else
          if collection.title != blank and page_title_product_add_collection == true
            assign page_title = page_title | append : page_title_seperator | append : collection_title
          else
            assign page_title = page_title
          endif
      endif

  elsif template == 'collection' and collection.title != blank
      assign collection_title = collection.title | capitalize
      assign page_title = collection_title
  endif

  if page_title_add_shop_name == true
      assign page_title = page_title | append : page_title_seperator | append : shop_name
  endif

  if template contains 'index'
  	assign page_title = shop_name
  endif

  unless template contains "customerservice"
    if template contains 'customers'
      assign extra_main_classes = ' bg-slgrey '
    elsif template contains '404'
      assign extra_main_classes = ' bg-slgrey full-page-wrapper hunderp full-page-max-h'
    endif
    if template contains 'customers' and template contains 'account'
      assign extra_main_classes = ''
    endif
  endunless

  assign current_asset_url_string_all = 'general.js' | asset_url
  assign current_asset_url_arr = current_asset_url_string_all | split: "/"
  assign current_asset_url_arr_last = current_asset_url_arr.last
  assign current_asset_url_string = current_asset_url_string_all | replace : current_asset_url_arr_last, ''

  assign schema_org_social_links_string = ''
  if settings.social_facebook_link != blank
    assign schema_org_social_links_string = schema_org_social_links_string | append : settings.social_facebook_link
  endif
  if settings.social_instagram_link != blank
    assign schema_org_social_links_string = schema_org_social_links_string | append : ',' | append : settings.social_instagram_link
  endif
  if settings.social_twitter_link != blank
    assign schema_org_social_links_string = schema_org_social_links_string | append : ',' | append : settings.social_twitter_link
  endif
  if settings.social_pinterest_link != blank
    assign schema_org_social_links_string = schema_org_social_links_string | append : ',' | append : settings.social_pinterest_link
  endif
  if settings.social_tumblr_link != blank
    assign schema_org_social_links_string = schema_org_social_links_string | append : ',' | append : settings.social_tumblr_link
  endif
  if settings.social_snapchat_link != blank
    assign schema_org_social_links_string = schema_org_social_links_string | append : ',' | append : settings.social_snapchat_link
  endif
  if settings.social_youtube_link != blank
    assign schema_org_social_links_string = schema_org_social_links_string | append : ',' | append : settings.social_youtube_link
  endif
  if settings.social_vimeo_link != blank
    assign schema_org_social_links_string = schema_org_social_links_string | append : ',' | append : settings.social_vimeo_link
  endif
  if settings.social_tiktok_link != blank
    assign schema_org_social_links_string = schema_org_social_links_string | append : ',' | append : settings.social_tiktok_link
  endif

  if settings.desktop_submenu_version == 'mega'
    assign use_desktop_submenu_menu_mega = 'true'
    assign use_desktop_submenu_foldable = 'false'
    assign use_desktop_submenu_dropdown = 'false'
  elsif settings.desktop_submenu_version == 'foldable'
    assign use_desktop_submenu_menu_mega = 'false'
    assign use_desktop_submenu_foldable = 'true'
    assign use_desktop_submenu_dropdown = 'false'
  elsif settings.desktop_submenu_version == 'dropdown'
    assign use_desktop_submenu_menu_mega = 'false'
    assign use_desktop_submenu_foldable = 'false'
    assign use_desktop_submenu_dropdown = 'true'
  endif

  assign use_mobile_menu_foldable = 'true'
  assign use_mobile_menu_drawer = 'false'

  include 'get-language'

  if request.page_type == 'product'
    include 'get-product-url', product: product
  endif

  assign current_market = localization.market.handle
  assign tp_ratingValue = ''
  assign tp_ratingCount = '' 
  assign tp_aggregateRating = '' 
  
  if current_market == 'nl'
    assign tp_ratingValue = '4.7'
    assign tp_ratingCount = '5'
    capture tp_aggregateRating
      echo ' "aggregateRating": {'
      echo '   "@type": "AggregateRating",'
      echo '   "ratingValue": "[tp_ratingValue]",' | replace : '[tp_ratingValue]' , tp_ratingValue
      echo '   "bestRating": "5",'
      echo '   "ratingCount": "[tp_ratingCount]"' | replace : '[tp_ratingCount]' , tp_ratingCount
      echo ' },'
    endcapture
  endif
  
  if request_page_type == 'page' and request_path contains '/shopping-cart'
    assign hit = false
    if website_use_shopping_cart_drawer == 'true'
      render 'header-shopping-cart-drawer'
      assign hit = true
    endif
    if website_use_shopping_cart_mini == 'true'
      render 'header-mini-cart'
      assign hit = true
    endif
    if hit == false
      echo '<script> cl("[theme.liquid] Redirect"); </script>'
      echo '<script> window.location.replace("/cart"); </script>'  
    endif
    break
  endif  
-%}

{%- capture body_classes -%}
page-loader-visible::pagetitle-{{ page_title | handle -}}::layout-footer-{{- theme_footer_template -}}::sc-drawer-invisible::cart-alert-invisible::template-{{- template | replace : '.', ' ' | truncatewords: 1, '' | handle -}}::
{%- if template.name != blank -%}template-name-{{- template.name -}}::{%- endif -%}
{%- if template.suffix != blank -%}template-suffix-{{- template.suffix -}}::{%- endif -%}
{%- if template contains 'customers' %}template-customer-area::{%- endif -%}
{%- if customer -%}customer-logged-in::{%- endif -%}announcement-is-enabled::
{%- endcapture -%}
{%- assign body_classes = body_classes | escape | replace :'®','' | replace : '::', ' ' | strip -%}
{%- assign body_id = page_title | handle | escape | replace :'®','' | replace : '::', ' ' | strip -%}
<!doctype html>
<html class="no-js" lang="{{ current_language }}">

{%- capture html_head_content -%}    
