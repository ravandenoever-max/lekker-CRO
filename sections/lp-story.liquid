{%- comment -%} Landingspagina: oprichtersverhaal, foto met citaat en korte tekst. Toegevoegd oktober 2026, CRO-project. {%- endcomment -%}
{%- assign s = section.settings -%}
<div class="section-inner lp-story bg-{{ s.section_background_color }} padding-t-md padding-b-md" id="{{ s.anchor_id | default: 'verhaal' | handleize }}">
  <div class="page-width">
    <div class="lp-story__grid">
      <div class="lp-story__media">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 992px) 45vw, 100vw', widths: '400, 600, 900', class: 'lp-story__img', alt: s.name }}
        {%- endif -%}
      </div>
      <div class="lp-story__body">
        {%- if s.heading != blank -%}<h2 class="font-fam-normal font-size-lg txt-lowercase lp-story__heading">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.quote != blank -%}<blockquote class="lp-story__quote font-fam-normal font-size-md">{{ s.quote }}</blockquote>{%- endif -%}
        {%- if s.text != blank -%}<div class="lp-story__text font-size-xs">{{ s.text }}</div>{%- endif -%}
        {%- if s.name != blank -%}<p class="lp-story__name font-size-xxs"><span class="font-fam-bold">{{ s.name }}</span>{% if s.role != blank %}, {{ s.role }}{% endif %}</p>{%- endif -%}
        {%- if s.button_label != blank -%}<div class="lp-story__button">{%- render 'theme-button', button_settings: s -%}</div>{%- endif -%}
      </div>
    </div>
  </div>
</div>
<style>
  .lp-story__grid { display: grid; gap: var(--spacing-xs); align-items: center; }
  .lp-story__img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 20px; }
  .lp-story__heading { margin: 0 0 var(--spacing-3xs); }
  .lp-story__quote { margin: 0 0 var(--spacing-3xs); padding-left: 14px; border-left: 3px solid var(--color-red); }
  .lp-story__text p { margin: 0 0 var(--spacing-4xs); }
  .lp-story__name { margin: var(--spacing-4xs) 0 0; }
  .lp-story__button { margin-top: var(--spacing-xxs); }
  @media screen and (min-width: 768px) { .lp-story__grid { grid-template-columns: 42% 1fr; gap: var(--spacing-md); } }
</style>
{% schema %}
{
  "name": "LP oprichtersverhaal",
  "tag": "section",
  "class": "lp-section lp-story-section",
  "settings": [
    { "type": "select", "id": "section_background_color", "default": "lpink", "label": "Achtergrond", "options": [ { "value": "lpink", "label": "Lichtroze" }, { "value": "lblue", "label": "Lichtblauw" }, { "value": "yellow", "label": "Geel" }, { "value": "white", "label": "Wit" } ] },
    { "type": "text", "id": "anchor_id", "label": "Anker", "default": "verhaal" },
    { "type": "image_picker", "id": "image", "label": "Foto" },
    { "type": "text", "id": "heading", "label": "Kop" },
    { "type": "textarea", "id": "quote", "label": "Citaat" },
    { "type": "richtext", "id": "text", "label": "Tekst" },
    { "type": "text", "id": "name", "label": "Naam" },
    { "type": "text", "id": "role", "label": "Rol" },
    { "type": "text", "id": "button_label", "label": "Knoptekst" },
    { "type": "text", "id": "button_link", "label": "Knoplink", "default": "#aanbod" },
    { "type": "select", "id": "button_size", "default": "button_small", "label": "Knopgrootte", "options": [ { "value": "button_small", "label": "Standaard" }, { "value": "button_large", "label": "Groot" } ] },
    { "type": "select", "id": "button_color", "default": "button_red", "label": "Knopkleur", "options": [ { "value": "button_red", "label": "Oranje" }, { "value": "button_hover_red", "label": "Oranje rand" }, { "value": "button_dgreen", "label": "Donkergroen" } ] },
    { "type": "checkbox", "id": "button_target", "default": false, "label": "Open in nieuw venster" }
  ],
  "presets": [ { "name": "LP oprichtersverhaal" } ]
}
{% endschema %}
