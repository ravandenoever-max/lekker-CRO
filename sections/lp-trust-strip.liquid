{%- comment -%} Landingspagina: smalle strook met korte zekerheden. Op mobiel één rij die je kunt swipen. Toegevoegd oktober 2026, CRO-project. {%- endcomment -%}
{%- assign s = section.settings -%}
<div class="section-inner lp-trust bg-{{ s.section_background_color }}">
  <ul class="lp-trust__list font-size-xxs" role="list">
    {%- for block in section.blocks -%}
      <li {{ block.shopify_attributes }}><span class="lp-check" aria-hidden="true">&#10003;</span> {{ block.settings.text }}</li>
    {%- endfor -%}
  </ul>
</div>
<style>
  .lp-trust { padding: 10px 0; }
  .lp-trust__list { list-style: none; margin: 0; padding: 0 20px; display: flex; flex-wrap: nowrap; gap: 6px 22px; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .lp-trust__list::-webkit-scrollbar { display: none; }
  .lp-trust__list li { white-space: nowrap; flex: 0 0 auto; }
  .lp-check { font-weight: 700; }
  @media screen and (min-width: 768px) {
    .lp-trust__list { flex-wrap: wrap; justify-content: center; overflow: visible; }
  }
</style>
{% schema %}
{
  "name": "LP trustrook",
  "tag": "section",
  "class": "lp-section lp-trust-section",
  "settings": [ { "type": "select", "id": "section_background_color", "default": "lblue", "label": "Achtergrond", "options": [ { "value": "lblue", "label": "Lichtblauw" }, { "value": "lpink", "label": "Roze" }, { "value": "yellow", "label": "Geel" }, { "value": "lilac", "label": "Lila" }, { "value": "white", "label": "Wit" } ] } ],
  "blocks": [ { "type": "item", "name": "Punt", "limit": 6, "settings": [ { "type": "text", "id": "text", "label": "Tekst" } ] } ],
  "presets": [ { "name": "LP trustrook" } ]
}
{% endschema %}
