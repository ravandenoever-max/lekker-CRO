<div class="page-width {% if cart == empty %} is-empty{% endif %}" id="main-cart-footer" data-id="{{ section.id }}">
  <div>
    <div class="cart__footer">
      <div class="txt-align-right" style="display:inline-block;width:100%;">
        <small class="tax-note font-fam-light font-size-3xs color-grey txt-uppercase">
          {%- liquid
            assign estimated_total_text = 'sections.cart.estimated_total_text' | t  | replace : '[break]', '<br>'
          -%}
          {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
            {{ 'sections.cart.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
          {%- elsif cart.taxes_included -%}
            {{ estimated_total_text }}
          {%- elsif shop.shipping_policy.body != blank -%}
            {{ 'sections.cart.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
          {%- else -%}
            {{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}
          {%- endif -%}
        </small>
      </div>
      {%- if section.settings.show_cart_note -%}
        <cart-note class="cart__note field">
          <label for="Cart-note">{{ 'sections.cart.note' | t }}</label>
          <textarea class="text-area text-area--resize-vertical field__input" name="note" id="Cart-note" placeholder="{{ 'sections.cart.note' | t }}">{{ cart.note }}</textarea>
        </cart-note>
      {%- endif -%}
      <div>
        {%- assign section_settings__show_cart_gift_wrap = 'false' -%}
        {%- if section_settings__show_cart_gift_wrap == 'true' -%}
          {%- render 'cart-product-gift-wrap' -%}
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'subtotal' -%}
              <div class="js-contents txt-align-right">
                <div class="totals">
                  <h3 class="font-fam-light font-size-xs color-black txt-lowercase totals__subtotal">{{ 'sections.cart.subtotal' | t }}</h3>
                  <h2 class="font-fam-light font-size-lg color-black txt-lowercase totals__subtotal-value">{{ cart.total_price | money | replace : ',00',',-' }}</h2>
                </div>
                <div>
                {%- if cart.cart_level_discount_applications.size > 0 -%}
                  <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                    {%- for discount in cart.cart_level_discount_applications -%}
                      <li class="discounts__discount discounts__discount--end">{%- render 'theme-icon', icon: 'icon-discount' -%} {{ discount.title }} (-{{ discount.total_allocated_amount | money | replace : ',00',',-' }}) </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
                </div>
              </div>
            {%- else -%}
              <div class="cart__ctas margin-b-xxs margin-t-xxs text-align-right">
                <noscript><button type="submit" class="cart__update-button button" form="cart">{{ 'sections.cart.update' | t }}</button></noscript>
                <button type="submit" style="max-width:260px;" class="theme-button theme-button__round-medium theme-button-hover__blue-grey-blue theme-button__red-white-red" name="checkout"{% if cart == empty %} disabled{% endif %} form="cart">{{ 'sections.cart.checkout' | t }}</button>
              </div>
              {%- assign use_additional_checkout_buttons = false -%}
              {%- if use_additional_checkout_buttons == true and additional_checkout_buttons -%}
                <div class="cart__dynamic-checkout-buttons additional-checkout-buttons">{{ content_for_additional_checkout_buttons }}</div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
        <div id="cart-errors"></div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-cart-footer.name",
  "tag": "section",
  "class": "cart__footer-wrapper",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_cart_note",
      "default":false,
     "label":"t:sections.main-cart-footer.settings.show_cart_note.label"
    }
  ],
  "blocks": [
    {
      "type": "subtotal",
      "name": "t:sections.main-cart-footer.blocks.subtotal.name",
      "limit": 1
    },
    {
      "type": "buttons",
      "name": "t:sections.main-cart-footer.blocks.buttons.name",
      "limit": 1
    }
  ]
}
{% endschema %}
