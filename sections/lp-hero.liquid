{%- comment -%}
  Landingspagina: hero met social proof, kop, tekst, prijs, twee knoppen en korte voordelen.
  Onderdeel van de herbruikbare landingspagina (page.lp-*.json). Toegevoegd oktober 2026, CRO-project.
  Zet ook de kleuren voor de hele landingspagina (alleen op pagina's met deze sectie).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign lp_product = s.price_product
  assign spacing = 'padding-t-' | append: s.row_spacing_inner_top | append: ' padding-b-' | append: s.row_spacing_inner_bottom
-%}

<div class="section-inner lp-hero bg-{{ s.section_background_color }} {{ spacing }}" id="lp-top">
  <div class="page-width">
    <div class="lp-hero__grid">
      <div class="lp-hero__media">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 992px) 50vw, 100vw', widths: '400, 600, 800, 1000, 1200', class: 'lp-hero__img', alt: s.image.alt }}
        {%- endif -%}
      </div>

      <div class="lp-hero__content">
        {%- if s.rating_text != blank -%}
          <p class="lp-hero__rating font-size-xxs">
            <span class="lp-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <span>{{ s.rating_text }}</span>
          </p>
        {%- endif -%}

        {%- if s.heading != blank -%}
          <h1 class="lp-hero__heading font-fam-normal font-size-xl txt-lowercase">{{ s.heading }}</h1>
        {%- endif -%}

        {%- if s.text != blank -%}
          <div class="lp-hero__text font-size-xs">{{ s.text }}</div>
        {%- endif -%}

        {%- if lp_product != blank -%}
          <p class="lp-hero__price font-fam-bold font-size-md">
            {{ s.price_prefix }} {{ lp_product.price_min | money }}
          </p>
        {%- endif -%}

        <div class="lp-hero__buttons">
          {%- if s.button_label != blank -%}
            {%- render 'theme-button', button_settings: s -%}
          {%- endif -%}
          {%- if s.link_label != blank -%}
            <a href="{{ s.link_url }}" class="lp-hero__link font-size-xxs">{{ s.link_label }}</a>
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <ul class="lp-hero__usps font-size-xxs" role="list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}><span class="lp-check" aria-hidden="true">&#10003;</span> {{ block.settings.text }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<style>
  {%- comment -%} Kleuren voor de hele landingspagina, alleen actief op pagina's met deze hero. {%- endcomment -%}
  body:has(.lp-hero) {
    --lp-ink: {{ s.ink_color }};
    --lp-accent: var(--color-red);
    background: var(--color-white);
  }
  body:has(.lp-hero) .color-black,
  body:has(.lp-hero) main h1,
  body:has(.lp-hero) main h2,
  body:has(.lp-hero) main h3,
  body:has(.lp-hero) main p,
  body:has(.lp-hero) main li { color: var(--lp-ink); }
  body:has(.lp-hero) main .color-white,
  body:has(.lp-hero) main .color-white * { color: var(--color-white); }
  body:has(.lp-hero) main .color-red { color: var(--color-red); }
  body:has(.lp-hero) main .theme-button,
  body:has(.lp-hero) main .theme-button * { color: inherit; }

  .lp-hero__grid { display: grid; gap: var(--spacing-xs); align-items: center; }
  .lp-hero__media { order: 0; }
  .lp-hero__img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 16px; }
  .lp-hero__rating { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 0 0 var(--spacing-4xs); }
  .lp-stars { color: var(--color-red); letter-spacing: 1px; }
  .lp-hero__heading { margin: 0 0 var(--spacing-4xs); }
  .lp-hero__text p { margin: 0 0 var(--spacing-4xs); }
  .lp-hero__price { margin: var(--spacing-4xs) 0 var(--spacing-3xs); }
  .lp-hero__buttons { display: flex; flex-wrap: wrap; align-items: center; gap: var(--spacing-xxs); }
  .lp-hero__link { color: var(--lp-ink); text-decoration: underline; text-underline-offset: 3px; }
  .lp-hero__usps { list-style: none; padding: 0; margin: var(--spacing-xxs) 0 0; display: flex; flex-wrap: wrap; gap: 6px 16px; }
  .lp-check { color: var(--color-red); }

  @media screen and (max-width: 991px) {
    .lp-hero__img { aspect-ratio: 16 / 10; }
  }
  @media screen and (min-width: 992px) {
    .lp-hero__grid { grid-template-columns: 1fr 1fr; gap: var(--spacing-md); }
    .lp-hero__media { order: 1; }
  }
</style>

<script>
  {%- comment -%}
    Ankerlinks (#kies, #winkels) laten werken naar secties van het thema.
    Shopify geeft secties een id die eindigt op __<sectiesleutel>; deze code zoekt daarop.
  {%- endcomment -%}
  document.addEventListener('click', function (e) {
    var a = e.target.closest('a[href^="#"]');
    if (!a) return;
    var key = a.getAttribute('href').slice(1);
    if (!key) return;
    var target = document.getElementById(key) || document.querySelector('[id$="__' + key + '"]');
    if (!target) return;
    e.preventDefault();
    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>

{% schema %}
{
  "name": "LP hero",
  "tag": "section",
  "class": "lp-section lp-hero-section",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "row_spacing_inner_top", "default": "xs", "label": "Spacing Top", "options": [ { "value": "md", "label": "MD" }, { "value": "sm", "label": "SM" }, { "value": "xs", "label": "XS" }, { "value": "xxs", "label": "xxs" }, { "value": "none", "label": "none" } ] },
    { "type": "select", "id": "row_spacing_inner_bottom", "default": "sm", "label": "Spacing Bottom", "options": [ { "value": "md", "label": "MD" }, { "value": "sm", "label": "SM" }, { "value": "xs", "label": "XS" }, { "value": "xxs", "label": "xxs" }, { "value": "none", "label": "none" } ] },
    { "type": "select", "id": "section_background_color", "default": "white", "label": "Background Color", "options": [ { "value": "white", "label": "White" }, { "value": "lblue", "label": "Light Blue" }, { "value": "trans", "label": "Transparent" } ] },
    { "type": "color", "id": "ink_color", "default": "#215732", "label": "Tekstkleur landingspagina", "info": "Geldt voor alle tekst op deze landingspagina. Volgens brandbook 2026 geen zwart." },
    { "type": "header", "content": "Content" },
    { "type": "image_picker", "id": "image", "label": "Afbeelding" },
    { "type": "text", "id": "rating_text", "label": "Reviewregel", "default": "4,7 uit 5 op Trustpilot, uit 432 reviews" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "een miljoen oksels gingen je voor" },
    { "type": "richtext", "id": "text", "label": "Tekst" },
    { "type": "product", "id": "price_product", "label": "Product voor de vanaf-prijs" },
    { "type": "text", "id": "price_prefix", "label": "Tekst voor de prijs", "default": "vanaf" },
    { "type": "header", "content": "Knoppen" },
    { "type": "text", "id": "button_label", "label": "Knop tekst", "default": "kies jouw geur" },
    { "type": "text", "id": "button_link", "label": "Knop link (#kies springt naar de productkeuze)", "default": "#kies" },
    { "type": "select", "id": "button_size", "default": "button_large", "label": "Knop grootte", "options": [ { "value": "button_small", "label": "Standaard" }, { "value": "button_large", "label": "Groot" } ] },
    { "type": "select", "id": "button_color", "default": "button_red", "label": "Knop kleur", "options": [ { "value": "button_red", "label": "Oranje" }, { "value": "button_dgreen", "label": "Donkergroen" }, { "value": "button_hover_red", "label": "Oranje rand" } ] },
    { "type": "checkbox", "id": "button_target", "default": false, "label": "Open in nieuw venster" },
    { "type": "text", "id": "link_label", "label": "Tweede link tekst", "default": "of vind 'm in de winkel" },
    { "type": "text", "id": "link_url", "label": "Tweede link (bijv. #winkels)", "default": "#winkels" }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "Voordeel",
      "limit": 4,
      "settings": [ { "type": "text", "id": "text", "label": "Tekst", "default": "binnen twee werkdagen bezorgd" } ]
    }
  ],
  "presets": [ { "name": "LP hero" } ]
}
{% endschema %}
