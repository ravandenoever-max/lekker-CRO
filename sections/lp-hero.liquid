{%- comment -%}
  Landingspagina: hero met het aanbod (starterspakket). Zet ook de kleuren voor de hele landingspagina (brandbook 2026).
  Toegevoegd oktober 2026, CRO-project. Alleen gebruikt in templates/page.lp-*.json.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign offer = s.offer_product
  assign extras = s.offer_extras
  assign offer_img = s.offer_image | default: offer.featured_image
  assign offer_total = offer.price
  assign offer_ids = offer.variants.first.id | append: ''
  assign extras_ok = true
  for x in extras
    assign offer_total = offer_total | plus: x.price
    assign offer_ids = offer_ids | append: ',' | append: x.variants.first.id
    unless x.available
      assign extras_ok = false
    endunless
  endfor
  assign sc = ':is(.lp-hero-section, .lp-hero-section ~ .shopify-section)'
-%}

<div class="section-inner lp-hero bg-{{ s.section_background_color }} padding-t-xs padding-b-sm" id="lp-top">
  <div class="page-width">
    <div class="lp-hero__grid">

      <div class="lp-hero__head">
        {%- if s.rating_text != blank -%}
          <p class="lp-hero__rating font-size-xxs"><span class="lp-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span> {{ s.rating_text }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h1 class="lp-hero__heading font-fam-normal font-size-xl txt-lowercase">{{ s.heading }}</h1>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="lp-hero__text font-size-xs">{{ s.text }}</div>
        {%- endif -%}
      </div>

      {%- if offer != blank -%}
      <div class="lp-offer bg-{{ s.offer_background_color }}" id="aanbod">
        {%- if s.offer_badge != blank -%}<span class="lp-pill lp-offer__badge font-size-3xs">{{ s.offer_badge }}</span>{%- endif -%}
        <div class="lp-offer__media">
          {%- if offer_img != blank -%}
            {{ offer_img | image_url: width: 1000 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 992px) 40vw, 100vw', widths: '400, 600, 800, 1000', class: 'lp-offer__img', alt: offer.title }}
          {%- endif -%}
        </div>
        <div class="lp-offer__body">
          <h2 class="lp-offer__title font-fam-normal font-size-md txt-lowercase">{{ s.offer_title | default: offer.title }}</h2>
          {%- if s.offer_text != blank -%}<div class="lp-offer__text font-size-xxs">{{ s.offer_text }}</div>{%- endif -%}
          <p class="lp-offer__price">
            <span class="font-fam-bold font-size-lg">{{ offer_total | money }}</span>
            {%- if s.offer_compare != blank -%} <s class="lp-offer__compare font-size-xxs">{{ s.offer_compare }}</s>{%- endif -%}
            {%- if s.offer_saving != blank -%} <span class="lp-pill lp-pill--yellow font-size-3xs">{{ s.offer_saving }}</span>{%- endif -%}
          </p>
          {%- if s.offer_shipping != blank -%}<p class="lp-offer__shipping font-size-xxs"><span class="lp-check" aria-hidden="true">&#10003;</span> {{ s.offer_shipping }}</p>{%- endif -%}
          <div class="lp-offer__button">
            {%- if extras.size > 0 and offer.available and extras_ok -%}
              <div data-ids="{{ offer_ids }}" class="lp-add-multi txt-align-center theme-button theme-button__round-medium theme-button__red-white-red theme-button-hover__red-red-white lp-add" role="button" tabindex="0"><span>{{ s.offer_button | default: 'in winkelwagen' }}</span></div>
            {%- elsif offer.available -%}
              <div data-pid="{{ offer.variants.first.id }}" class="js-trigger-add-product-inactive txt-align-center theme-button theme-button__round-medium theme-button__red-white-red theme-button-hover__red-red-white lp-add"><span>{{ s.offer_button | default: 'in winkelwagen' }}</span></div>
              <div class="visually-hidden"><form method="post" action="/cart/add" id="pid-{{ offer.variants.first.id }}"><input type="hidden" name="id" value="{{ offer.variants.first.id }}"><input type="hidden" name="quantity" value="1"><input type="submit" value="Add"></form></div>
            {%- else -%}
              <a href="{{ offer.url }}" class="theme-button theme-button__round-medium theme-button__grey-white-grey"><span>uitverkocht</span></a>
            {%- endif -%}
          </div>
          {%- if s.offer_alt_label != blank -%}<a href="{{ s.offer_alt_link }}" class="lp-offer__alt font-size-xxs">{{ s.offer_alt_label }}</a>{%- endif -%}
        </div>
      </div>
      {%- endif -%}

      <div class="lp-hero__extras">
        {%- if section.blocks.size > 0 -%}
          <ul class="lp-hero__usps font-size-xxs" role="list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}><span class="lp-check" aria-hidden="true">&#10003;</span> {{ block.settings.text }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if s.retail_text != blank -%}
          <p class="lp-hero__retail font-size-xxs">{{ s.retail_text }}</p>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

<style>
  {%- comment -%} Kleuren en regels voor de hele landingspagina (brandbook 2026): de hero en alle secties erna. {%- endcomment -%}
  .lp-hero-section, .lp-hero-section ~ .shopify-section {
    --lp-ink: var(--color-black);
    --lp-heading: var(--color-red);
    --lp-accent: var(--color-red);
    --lp-radius: 30px;
    --lp-radius-sm: 20px;
  }
  {%- comment -%} Alleen themakleuren gebruiken, zodat de pagina aansluit op de rest van de site. Knoppen houden de themastijl. {%- endcomment -%}
  {{ sc }} :is(p, li, span, blockquote, strong, em, label, s) { color: var(--lp-ink) !important; }
  {{ sc }} .color-black { color: var(--lp-ink) !important; }
  {{ sc }} :is(h1, h2, h3, h4, h5, h6), {{ sc }} :is(h1, h2, h3, h4, h5, h6).color-black { color: var(--lp-heading) !important; }
  {{ sc }} :is(h1, h2, h3, h4, h5, h6) :is(span, strong, em) { color: inherit !important; }
  {{ sc }} :is(.color-red, .color-red *, .lp-stars, .lp-star, .lp-check, .lp-x, .lp-accent) { color: var(--lp-accent) !important; }
  {{ sc }} :is(.color-white, .color-white *, .lp-on-dark, .lp-on-dark *) { color: var(--color-white) !important; }
  {{ sc }} .lp-star--empty { color: var(--color-lgrey) !important; }
  {{ sc }} .theme-button :is(span, strong, em) { color: inherit !important; }
  {{ sc }} .lp-pill { display: inline-block; background: var(--lp-accent); color: var(--color-white) !important; padding: 4px 12px; border-radius: 800px; text-transform: lowercase; line-height: 1.4; white-space: nowrap; }
  {{ sc }} .lp-pill--yellow { background: var(--color-yellow); color: var(--lp-ink) !important; }
  {%- comment -%} Introteksten niet over de volle breedte, dat leest niet. {%- endcomment -%}
  {{ sc }} :is(.lp-compare__intro, .lp-picker__intro, .lp-logos__intro, .lp-video__intro, .lp-steps__intro, .lp-picker__footnote, .lp-logos__footnote) { max-width: 720px; margin-left: auto; margin-right: auto; }
  {{ sc }} [id] { scroll-margin-top: calc(var(--theme-header-height) + 16px); }
  {%- comment -%} Twee witte secties onder elkaar: minder witruimte ertussen. {%- endcomment -%}
  .lp-hero-section ~ .shopify-section:has(> .section-inner.bg-white) + .shopify-section:has(> .section-inner.bg-white) > .section-inner { padding-top: var(--spacing-xxs) !important; }
  body:has(.lp-hero) { background: var(--color-white); }

  .lp-hero__grid { display: grid; gap: var(--spacing-xxs); grid-template-areas: 'head' 'offer' 'extras'; }
  .lp-hero__head { grid-area: head; }
  .lp-offer { grid-area: offer; }
  .lp-hero__extras { grid-area: extras; }
  .lp-hero__rating { margin: 0 0 var(--spacing-4xs); }
  .lp-stars { letter-spacing: 1px; }
  .lp-hero__heading { margin: 0 0 var(--spacing-4xs); }
  .lp-hero__text p { margin: 0; }
  .lp-hero__usps { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .lp-hero__retail { margin: var(--spacing-3xs) 0 0; }
  .lp-check { font-weight: 700; }

  .lp-offer { position: relative; border-radius: var(--lp-radius); padding: var(--spacing-xxs); display: grid; gap: var(--spacing-xxs); }
  .lp-offer__badge { position: absolute; top: 14px; left: 14px; z-index: 2; }
  .lp-offer__img { display: block; width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; border-radius: var(--lp-radius-sm); background: var(--color-white); }
  .lp-offer__media, .lp-offer__body { min-width: 0; }
  .lp-offer__title { margin: 0 0 4px; }
  .lp-offer__text p { margin: 0; }
  .lp-offer__price { margin: var(--spacing-4xs) 0 2px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .lp-offer__compare { }
  .lp-offer__shipping { margin: 0 0 var(--spacing-3xs); }
  .lp-offer__button .theme-button { display: block; width: 100%; }
  .lp-offer__alt { display: inline-block; margin-top: 14px; text-decoration: underline; text-underline-offset: 3px; }

  @media screen and (max-width: 767px) {
    .lp-hero { padding-top: 16px; }
    .lp-hero__heading { font-size: 28px; line-height: 1.15; }
    .lp-hero__extras { display: none; }
    .lp-offer { padding: 10px; gap: 10px; }
    .lp-offer__badge { top: 18px; left: 18px; }
    .lp-offer__img { aspect-ratio: 4 / 3; }
    .lp-offer__body { padding: 0 6px 6px; }
    .lp-offer__alt { margin-top: 8px; display: block; text-align: center; }
  }
  @media screen and (min-width: 768px) and (max-width: 991px) {
    .lp-offer { grid-template-columns: 42% 1fr; align-items: center; }
    .lp-offer__button, .lp-offer__alt { grid-column: 1 / -1; }
  }
  @media screen and (min-width: 992px) {
    .lp-hero__grid { grid-template-columns: 1.05fr 1fr; grid-template-areas: 'head offer' 'extras offer'; gap: var(--spacing-xxs) var(--spacing-md); align-items: start; }
    .lp-offer { grid-template-columns: 40% 1fr; align-items: center; gap: var(--spacing-xxs); padding: var(--spacing-xxs); align-self: center; }
    .lp-offer__button { grid-column: 1 / -1; }
    .lp-offer__alt { grid-column: 1 / -1; margin-top: 4px; text-align: center; }
  }
</style>

<script>
  {%- comment -%} Pakket van meerdere producten in één keer in de winkelwagen (zelfde drawer-update als het thema). {%- endcomment -%}
  (function () {
    function addMulti(btn) {
      if (btn.classList.contains('loading')) return;
      var items = btn.getAttribute('data-ids').split(',').map(function (id) { return { id: parseInt(id, 10), quantity: 1 }; });
      btn.classList.add('loading');
      window.shopping_cart_content_has_changed = 'true';
      fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ items: items }) })
        .then(function (r) { return r.json(); })
        .then(function () {
          if (typeof UpdateShoppingCartDrawer === 'function') UpdateShoppingCartDrawer('update');
          if (typeof UpdateHeaderIconBubble === 'function') UpdateHeaderIconBubble(items.length);
        })
        .catch(function (e) { console.error(e); })
        .finally(function () { btn.classList.remove('loading'); });
    }
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('.lp-add-multi');
      if (btn) { e.preventDefault(); addMulti(btn); }
    });
  })();
  (function () {
    function target(key) { return document.getElementById(key) || document.querySelector('[id$="__' + key + '"]'); }
    function go(el, smooth) { el.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' }); }
    document.addEventListener('click', function (e) {
      var a = e.target.closest('a[href^="#"]');
      if (!a) return;
      var key = a.getAttribute('href').slice(1);
      var el = key && target(key);
      if (!el) return;
      e.preventDefault();
      go(el, true);
      {%- comment -%} Correctie: afbeeldingen die tijdens het scrollen laden verschuiven de pagina. {%- endcomment -%}
      setTimeout(function () { go(el, false); }, 900);
      setTimeout(function () { go(el, false); }, 1600);
    });
  })();
</script>

{% schema %}
{
  "name": "LP hero",
  "tag": "section",
  "class": "lp-section lp-hero-section",
  "settings": [
    { "type": "select", "id": "section_background_color", "default": "white", "label": "Achtergrond hero", "options": [ { "value": "white", "label": "Wit" }, { "value": "lblue", "label": "Lichtblauw" }, { "value": "lpink", "label": "Roze" } ] },
    { "type": "header", "content": "Tekst" },
    { "type": "text", "id": "rating_text", "label": "Reviewregel", "default": "4,7 uit 5 op Trustpilot" },
    { "type": "text", "id": "heading", "label": "Kop" },
    { "type": "richtext", "id": "text", "label": "Tekst", "info": "Op mobiel: hou het bij één of twee regels." },
    { "type": "text", "id": "retail_text", "label": "Regel over winkels (alleen desktop)", "default": "Ligt ook bij Albert Heijn, Etos, Holland & Barrett en DA. Alle geuren samen vind je alleen hier." },
    { "type": "header", "content": "Aanbod" },
    { "type": "product", "id": "offer_product", "label": "Product (wordt direct in de winkelwagen gelegd)" },
    { "type": "product_list", "id": "offer_extras", "label": "Extra producten in het pakket (gaan samen in de winkelwagen)", "limit": 3 },
    { "type": "image_picker", "id": "offer_image", "label": "Afbeelding (leeg = productfoto)" },
    { "type": "select", "id": "offer_background_color", "default": "lblue", "label": "Achtergrond aanbod", "options": [ { "value": "lblue", "label": "Lichtblauw" }, { "value": "lpink", "label": "Roze" }, { "value": "yellow", "label": "Geel" }, { "value": "white", "label": "Wit" } ] },
    { "type": "text", "id": "offer_badge", "label": "Label", "default": "meest gekozen" },
    { "type": "text", "id": "offer_title", "label": "Titel (leeg = productnaam)" },
    { "type": "richtext", "id": "offer_text", "label": "Omschrijving" },
    { "type": "text", "id": "offer_compare", "label": "Doorgestreepte prijs naast de prijs" },
    { "type": "text", "id": "offer_saving", "label": "Besparing (geel label)" },
    { "type": "text", "id": "offer_shipping", "label": "Bezorgregel", "default": "gratis thuisbezorgd, binnen twee werkdagen" },
    { "type": "text", "id": "offer_button", "label": "Knoptekst", "default": "in winkelwagen" },
    { "type": "text", "id": "offer_alt_label", "label": "Link eronder", "default": "liever één geur? kies hieronder" },
    { "type": "text", "id": "offer_alt_link", "label": "Link eronder (url of #anker)", "default": "#kies" }
  ],
  "blocks": [ { "type": "usp", "name": "Voordeel (alleen desktop)", "limit": 4, "settings": [ { "type": "text", "id": "text", "label": "Tekst" } ] } ],
  "presets": [ { "name": "LP hero" } ]
}
{% endschema %}
