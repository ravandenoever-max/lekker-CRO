{%- comment -%}
  Landingspagina: hero met het aanbod (starterspakket). Zet ook de tekstkleur voor de hele landingspagina.
  Toegevoegd oktober 2026, CRO-project. Alleen gebruikt in templates/page.lp-*.json.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign offer = s.offer_product
  assign offer_img = s.offer_image | default: offer.featured_image
-%}

<div class="section-inner lp-hero bg-{{ s.section_background_color }} padding-t-xs padding-b-sm" id="lp-top">
  <div class="page-width">
    <div class="lp-hero__grid">

      <div class="lp-hero__head">
        {%- if s.rating_text != blank -%}
          <p class="lp-hero__rating font-size-xxs"><span class="lp-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span> {{ s.rating_text }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h1 class="lp-hero__heading font-fam-normal font-size-xl txt-lowercase">{{ s.heading }}</h1>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="lp-hero__text font-size-xs">{{ s.text }}</div>
        {%- endif -%}
      </div>

      {%- if offer != blank -%}
      <div class="lp-offer bg-{{ s.offer_background_color }}" id="aanbod">
        {%- if s.offer_badge != blank -%}<span class="lp-offer__badge font-size-3xs">{{ s.offer_badge }}</span>{%- endif -%}
        <div class="lp-offer__media">
          {%- if offer_img != blank -%}
            {{ offer_img | image_url: width: 900 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 992px) 40vw, 100vw', widths: '400, 600, 900', class: 'lp-offer__img', alt: offer.title }}
          {%- endif -%}
        </div>
        <div class="lp-offer__body">
          <h2 class="lp-offer__title font-fam-normal font-size-md txt-lowercase">{{ s.offer_title | default: offer.title }}</h2>
          {%- if s.offer_text != blank -%}<div class="lp-offer__text font-size-xxs">{{ s.offer_text }}</div>{%- endif -%}
          <p class="lp-offer__price">
            <span class="font-fam-bold font-size-lg">{{ offer.price | money }}</span>
            {%- if s.offer_compare != blank -%} <span class="lp-offer__compare font-size-xxs">{{ s.offer_compare }}</span>{%- endif -%}
          </p>
          {%- if s.offer_shipping != blank -%}<p class="lp-offer__shipping font-size-xxs"><span class="lp-check" aria-hidden="true">&#10003;</span> {{ s.offer_shipping }}</p>{%- endif -%}
          <div class="lp-offer__button">
            {%- if offer.available -%}
              <div data-pid="{{ offer.variants.first.id }}" class="js-trigger-add-product-inactive txt-align-center theme-button theme-button__round-medium theme-button__red-white-red theme-button-hover__red-red-white lp-add"><span>{{ s.offer_button | default: 'in winkelwagen' }}</span></div>
              <div class="visually-hidden"><form method="post" action="/cart/add" id="pid-{{ offer.variants.first.id }}"><input type="hidden" name="id" value="{{ offer.variants.first.id }}"><input type="hidden" name="quantity" value="1"><input type="submit" value="Add"></form></div>
            {%- else -%}
              <a href="{{ offer.url }}" class="theme-button theme-button__round-medium theme-button__grey-white-grey"><span>uitverkocht</span></a>
            {%- endif -%}
          </div>
          {%- if s.offer_alt_label != blank -%}<a href="{{ s.offer_alt_link }}" class="lp-offer__alt font-size-xxs">{{ s.offer_alt_label }}</a>{%- endif -%}
        </div>
      </div>
      {%- endif -%}

      <div class="lp-hero__extras">
        {%- if section.blocks.size > 0 -%}
          <ul class="lp-hero__usps font-size-xxs" role="list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}><span class="lp-check" aria-hidden="true">&#10003;</span> {{ block.settings.text }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if s.retail_text != blank -%}
          <p class="lp-hero__retail font-size-xxs">{{ s.retail_text }}</p>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

<style>
  {%- comment -%} Tekstkleur voor de hele landingspagina: de hero en alle secties erna. {%- endcomment -%}
  .lp-hero-section, .lp-hero-section ~ .shopify-section { --lp-ink: {{ s.ink_color }}; }
  :is(.lp-hero-section, .lp-hero-section ~ .shopify-section) :is(h1, h2, h3, h4, h5, h6, p, li, span, blockquote, strong, em, label, .color-black) { color: var(--lp-ink) !important; }
  :is(.lp-hero-section, .lp-hero-section ~ .shopify-section) :is(.color-red, .color-red *, .lp-stars, .lp-star, .lp-check, .lp-x) { color: var(--color-red) !important; }
  :is(.lp-hero-section, .lp-hero-section ~ .shopify-section) :is(.color-white, .color-white *, .lp-on-dark, .lp-on-dark *) { color: var(--color-white) !important; }
  :is(.lp-hero-section, .lp-hero-section ~ .shopify-section) .lp-star--empty { color: var(--color-lgrey) !important; }
  :is(.lp-hero-section, .lp-hero-section ~ .shopify-section) .theme-button :is(span, strong, em) { color: inherit !important; }
  :is(.lp-hero-section, .lp-hero-section ~ .shopify-section) [id] { scroll-margin-top: calc(var(--theme-header-height) + 16px); }
  body:has(.lp-hero) { background: var(--color-white); }

  .lp-hero__grid { display: grid; gap: var(--spacing-xs); grid-template-areas: 'head' 'offer' 'extras'; }
  .lp-hero__head { grid-area: head; }
  .lp-offer { grid-area: offer; }
  .lp-hero__extras { grid-area: extras; }
  .lp-hero__rating { margin: 0 0 var(--spacing-4xs); }
  .lp-stars { color: var(--color-red); letter-spacing: 1px; }
  .lp-hero__heading { margin: 0 0 var(--spacing-4xs); }
  .lp-hero__text p { margin: 0; }
  .lp-hero__usps { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .lp-hero__retail { margin: var(--spacing-3xs) 0 0; opacity: .8; }
  .lp-check { color: var(--color-red); font-weight: 700; }

  .lp-offer { position: relative; border-radius: 20px; padding: var(--spacing-xxs); display: grid; gap: var(--spacing-xxs); }
  .lp-offer__badge { position: absolute; top: 14px; left: 14px; z-index: 2; background: var(--color-red); color: var(--color-white) !important; padding: 5px 12px; border-radius: 800px; text-transform: lowercase; }
  .lp-offer__img { display: block; width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 14px; background: var(--color-white); }
  .lp-offer__media, .lp-offer__body { min-width: 0; }
  .lp-offer__title { margin: 0 0 4px; }
  .lp-offer__text p { margin: 0; }
  .lp-offer__price { margin: var(--spacing-4xs) 0 2px; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .lp-offer__compare { opacity: .75; }
  .lp-offer__shipping { margin: 0 0 var(--spacing-3xs); }
  .lp-offer__button .theme-button { display: block; width: 100%; }
  .lp-offer__alt { display: inline-block; margin-top: 10px; text-decoration: underline; text-underline-offset: 3px; }

  @media screen and (max-width: 767px) {
    .lp-offer { grid-template-columns: 38% 1fr; align-items: center; gap: 12px; padding: 12px; }
    .lp-offer__badge { top: 8px; left: 8px; }
    .lp-offer__img { border-radius: 10px; }
    .lp-offer__button { grid-column: 1 / -1; }
    .lp-offer__alt { grid-column: 1 / -1; margin-top: 0; text-align: center; }
  }
  @media screen and (min-width: 768px) and (max-width: 991px) {
    .lp-offer { grid-template-columns: 42% 1fr; align-items: center; }
  }
  @media screen and (min-width: 992px) {
    .lp-hero__grid { grid-template-columns: 1.05fr 1fr; grid-template-areas: 'head offer' 'extras offer'; gap: var(--spacing-xxs) var(--spacing-md); align-items: start; }
    .lp-offer { grid-template-columns: 40% 1fr; align-items: center; gap: var(--spacing-xxs); padding: var(--spacing-xxs); align-self: center; }
    .lp-offer__button { grid-column: 1 / -1; }
    .lp-offer__alt { grid-column: 1 / -1; margin-top: 0; text-align: center; }
  }
</style>

<script>
  (function () {
    function target(key) { return document.getElementById(key) || document.querySelector('[id$="__' + key + '"]'); }
    function go(el, smooth) { el.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' }); }
    document.addEventListener('click', function (e) {
      var a = e.target.closest('a[href^="#"]');
      if (!a) return;
      var key = a.getAttribute('href').slice(1);
      var el = key && target(key);
      if (!el) return;
      e.preventDefault();
      go(el, true);
      {%- comment -%} Correctie: afbeeldingen die tijdens het scrollen laden verschuiven de pagina. {%- endcomment -%}
      setTimeout(function () { go(el, false); }, 900);
      setTimeout(function () { go(el, false); }, 1600);
    });
  })();
</script>

{% schema %}
{
  "name": "LP hero",
  "tag": "section",
  "class": "lp-section lp-hero-section",
  "settings": [
    { "type": "select", "id": "section_background_color", "default": "white", "label": "Achtergrond", "options": [ { "value": "white", "label": "Wit" }, { "value": "lblue", "label": "Lichtblauw" }, { "value": "lpink", "label": "Lichtroze" } ] },
    { "type": "color", "id": "ink_color", "default": "#215732", "label": "Tekstkleur landingspagina", "info": "Geldt voor de hele landingspagina. Brandbook 2026: geen zwart." },
    { "type": "header", "content": "Tekst" },
    { "type": "text", "id": "rating_text", "label": "Reviewregel", "default": "4,7 uit 5 op Trustpilot" },
    { "type": "text", "id": "heading", "label": "Kop" },
    { "type": "richtext", "id": "text", "label": "Tekst" },
    { "type": "text", "id": "retail_text", "label": "Regel over winkels (zonder link)", "default": "Ligt ook bij Albert Heijn, Etos, Holland & Barrett en DA. Alle geuren samen vind je alleen hier." },
    { "type": "header", "content": "Aanbod" },
    { "type": "product", "id": "offer_product", "label": "Product (wordt direct in de winkelwagen gelegd)" },
    { "type": "image_picker", "id": "offer_image", "label": "Afbeelding (leeg = productfoto)" },
    { "type": "select", "id": "offer_background_color", "default": "lblue", "label": "Achtergrond aanbod", "options": [ { "value": "lblue", "label": "Lichtblauw" }, { "value": "lpink", "label": "Lichtroze" }, { "value": "yellow", "label": "Geel" }, { "value": "white", "label": "Wit" } ] },
    { "type": "text", "id": "offer_badge", "label": "Label", "default": "meest gekozen" },
    { "type": "text", "id": "offer_title", "label": "Titel (leeg = productnaam)" },
    { "type": "richtext", "id": "offer_text", "label": "Omschrijving" },
    { "type": "text", "id": "offer_compare", "label": "Tekst naast de prijs", "default": "los €24,87" },
    { "type": "text", "id": "offer_shipping", "label": "Bezorgregel", "default": "gratis thuisbezorgd, binnen twee werkdagen" },
    { "type": "text", "id": "offer_button", "label": "Knoptekst", "default": "in winkelwagen" },
    { "type": "text", "id": "offer_alt_label", "label": "Link eronder", "default": "liever één geur? kies hieronder" },
    { "type": "text", "id": "offer_alt_link", "label": "Link eronder (url of #anker)", "default": "#kies" }
  ],
  "blocks": [ { "type": "usp", "name": "Voordeel", "limit": 4, "settings": [ { "type": "text", "id": "text", "label": "Tekst" } ] } ],
  "presets": [ { "name": "LP hero" } ]
}
{% endschema %}
