{%- comment -%}
  Landingspagina: uitgelichte reviews. Alleen echte reviews van klanten gebruiken
  (bijvoorbeeld uit Judge.me op de productpagina's), met naam en product zoals ze daar staan.
  Toegevoegd oktober 2026, CRO-project.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign spacing = 'padding-t-' | append: s.row_spacing_inner_top | append: ' padding-b-' | append: s.row_spacing_inner_bottom
-%}

<div class="section-inner lp-reviews bg-{{ s.section_background_color }} {{ spacing }}" id="{{ s.anchor_id | default: 'reviews' | handleize }}">
  <div class="page-width">
    <div class="txt-align-center margin-b-xs">
      {%- if s.heading != blank -%}
        <h2 class="font-fam-normal font-size-lg txt-lowercase">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.summary != blank -%}
        <p class="lp-reviews__summary font-size-xs margin-t-xxs">
          <span class="lp-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span> {{ s.summary }}
        </p>
      {%- endif -%}
    </div>

    <ul class="lp-reviews__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign stars = block.settings.rating | plus: 0 -%}
        <li class="lp-reviews__item bg-white" {{ block.shopify_attributes }}>
          <p class="lp-reviews__stars" aria-label="{{ stars }} van 5 sterren">
            {%- for i in (1..5) -%}<span class="{% if i > stars %}lp-star--empty{% else %}lp-star{% endif %}" aria-hidden="true">&#9733;</span>{%- endfor -%}
          </p>
          <blockquote class="lp-reviews__quote font-size-xs">{{ block.settings.quote }}</blockquote>
          <p class="lp-reviews__author font-size-xxs">
            <span class="font-fam-bold">{{ block.settings.name }}</span>{% if block.settings.product != blank %}, {{ block.settings.product }}{% endif %}
          </p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

<style>
  .lp-reviews__summary { margin: 0; }
  .lp-reviews__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--spacing-xxs); }
  .lp-reviews__item { border-radius: 16px; padding: var(--spacing-xxs); display: flex; flex-direction: column; gap: 8px; }
  .lp-reviews__stars { margin: 0; letter-spacing: 1px; }
  .lp-star { color: var(--color-red); }
  .lp-star--empty { color: var(--color-lgrey); }
  .lp-reviews__quote { margin: 0; flex: 1; }
  .lp-reviews__author { margin: 0; }
  @media screen and (min-width: 768px) {
    .lp-reviews__list { grid-template-columns: repeat(2, 1fr); }
  }
  @media screen and (min-width: 992px) {
    .lp-reviews__list { grid-template-columns: repeat(4, 1fr); }
  }
</style>

{% schema %}
{
  "name": "LP reviews",
  "tag": "section",
  "class": "lp-section lp-reviews-section",
  "settings": [
    { "type": "select", "id": "row_spacing_inner_top", "default": "md", "label": "Spacing Top", "options": [ { "value": "lg", "label": "LG" }, { "value": "md", "label": "MD" }, { "value": "sm", "label": "SM" }, { "value": "xs", "label": "XS" }, { "value": "none", "label": "none" } ] },
    { "type": "select", "id": "row_spacing_inner_bottom", "default": "md", "label": "Spacing Bottom", "options": [ { "value": "lg", "label": "LG" }, { "value": "md", "label": "MD" }, { "value": "sm", "label": "SM" }, { "value": "xs", "label": "XS" }, { "value": "none", "label": "none" } ] },
    { "type": "select", "id": "section_background_color", "default": "lblue", "label": "Background Color", "options": [ { "value": "white", "label": "White" }, { "value": "lblue", "label": "Light Blue" } ] },
    { "type": "text", "id": "anchor_id", "label": "Anker", "default": "reviews" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "wat anderen ervan vinden" },
    { "type": "text", "id": "summary", "label": "Samenvatting", "info": "Noem Trustpilot hier niet als de hero dat al doet (maximaal één keer op de site)." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "limit": 8,
      "settings": [
        { "type": "range", "id": "rating", "label": "Sterren", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Review (letterlijk, mag ingekort)" },
        { "type": "text", "id": "name", "label": "Naam" },
        { "type": "text", "id": "product", "label": "Product" }
      ]
    }
  ],
  "presets": [ { "name": "LP reviews" } ]
}
{% endschema %}
