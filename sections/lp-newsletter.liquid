{%- comment -%} Landingspagina: welkomstkorting via het bestaande nieuwsbriefformulier van het thema (snippets/footer-newsletter.liquid, tag newsletter). Toegevoegd oktober 2026, CRO-project. {%- endcomment -%}
{%- assign s = section.settings -%}
<div class="section-inner lp-news bg-{{ s.section_background_color }} padding-t-md padding-b-md" id="{{ s.anchor_id | default: 'korting' | handleize }}">
  <div class="page-width--narrow lp-news__inner lp-on-dark">
    {%- if s.badge != blank -%}<p class="lp-news__badge font-size-3xs">{{ s.badge }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="font-fam-normal font-size-lg txt-lowercase lp-news__heading">{{ s.heading }}</h2>{%- endif -%}
    {%- if s.text != blank -%}<div class="font-size-xs lp-news__text">{{ s.text }}</div>{%- endif -%}
    <div class="lp-news__form">{%- render 'footer-newsletter', version: 'minified_no_text', given_tags: s.tag -%}</div>
    {%- if s.small != blank -%}<p class="font-size-3xs lp-news__small">{{ s.small }}</p>{%- endif -%}
  </div>
</div>
<style>
  .lp-news__inner { margin: 0 auto; padding: 0 var(--spacing-xxs); text-align: center; max-width: 560px; }
  .lp-news__badge { display: inline-block; margin: 0 0 var(--spacing-3xs); padding: 4px 12px; border-radius: 800px; border: 1px solid rgba(255,255,255,.7); text-transform: lowercase; }
  .lp-news__heading { margin: 0 0 var(--spacing-4xs); }
  .lp-news__text p { margin: 0 0 var(--spacing-xxs); }
  .lp-news__form .newsletter-form__field-wrapper { display: flex; align-items: center; gap: 10px; background: var(--color-white); border-radius: 800px; padding: 6px 6px 6px 18px; }
  .lp-news__form .col-field { flex: 1; min-width: 0; }
  .lp-news__form .col-button { position: static; flex: 0 0 auto; }
  .lp-news__form .field__input { width: 100%; border: 0; background: transparent; outline: none; padding: 8px 0; color: var(--color-dgreen) !important; }
  .lp-news__form .field__input::placeholder { color: var(--color-dgreen); opacity: .7; }
  .lp-news__form .field__label { display: none; }
  .lp-news__form .css-arrow { cursor: pointer; width: 40px; height: 40px; margin: 0; border-radius: 50%; background: var(--color-red); display: flex; align-items: center; justify-content: center; position: relative; }
  .lp-news__form .newsletter-form__message { display: block; margin-top: 8px; }
  .lp-news__small { margin: var(--spacing-3xs) 0 0; opacity: .8; }
</style>
{% schema %}
{
  "name": "LP welkomstkorting",
  "tag": "section",
  "class": "lp-section lp-news-section",
  "settings": [
    { "type": "select", "id": "section_background_color", "default": "dgreen", "label": "Achtergrond", "options": [ { "value": "dgreen", "label": "Donkergroen" }, { "value": "red", "label": "Oranje" }, { "value": "pink", "label": "Roze" } ] },
    { "type": "text", "id": "anchor_id", "label": "Anker", "default": "korting" },
    { "type": "text", "id": "badge", "label": "Label", "default": "alleen online" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "15% korting op je eerste bestelling" },
    { "type": "richtext", "id": "text", "label": "Tekst" },
    { "type": "text", "id": "tag", "label": "Extra klanttag", "default": "lp-deostick" },
    { "type": "text", "id": "small", "label": "Kleine lettertjes", "default": "Je ontvangt de kortingscode per e-mail. Uitschrijven kan altijd." }
  ],
  "presets": [ { "name": "LP welkomstkorting" } ]
}
{% endschema %}
