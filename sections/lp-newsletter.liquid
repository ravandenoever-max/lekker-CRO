{%- comment -%}
  Landingspagina: aanmelden voor gratis verzending op de eerste bestelling via het Drip formulier (snippets/lekker-drip-form.liquid).
  Versturen en stijl van het formulier staan in snippets/lekker-drip.liquid (geladen via de footer).
  Toegevoegd oktober 2026, CRO-project. Eerst welkomstkorting via Shopify, sinds 28 oktober 2026 Drip gratis verzending.
{%- endcomment -%}
{%- assign s = section.settings -%}
<div class="section-inner lp-news bg-{{ s.section_background_color }} padding-t-md padding-b-md" id="{{ s.anchor_id | default: 'gratis-verzending' | handleize }}">
  <div class="page-width">
    <div class="lp-news__card bg-{{ s.card_background_color | default: 'lpink' }}">
      <div class="lp-news__copy">
        {%- if s.badge != blank -%}<p class="lp-news__badge font-size-3xs">{{ s.badge }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="font-fam-normal font-size-lg txt-lowercase lp-news__heading">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="font-size-xs lp-news__text">{{ s.text }}</div>{%- endif -%}
      </div>
      <div class="lp-news__form">
        {%- render 'lekker-drip-form', location: 'lp', button_label: s.button_label -%}
        {%- if s.small != blank -%}<p class="font-size-3xs lp-news__small">{{ s.small }}</p>{%- endif -%}
      </div>
    </div>
  </div>
</div>
<style>
  .lp-news__card { max-width: 960px; margin: 0 auto; padding: 28px 20px; border-radius: var(--lp-radius, 30px); text-align: center; display: grid; gap: 20px; }
  .lp-news__badge { display: inline-block; margin: 0 0 10px; padding: 4px 12px; border-radius: 800px; background: var(--color-white); color: var(--color-black); text-transform: lowercase; }
  .lp-news__heading { margin: 0 0 8px; }
  .lp-news__text p { margin: 0; }
  .lp-news__small { margin: 10px 0 0; opacity: .7; }
  @media screen and (min-width: 768px) {
    .lp-news__card { grid-template-columns: 1fr 1.1fr; align-items: center; gap: var(--spacing-xs); padding: 40px; text-align: left; }
  }
</style>
{% schema %}
{
  "name": "LP gratis verzending",
  "tag": "section",
  "class": "lp-section lp-news-section",
  "settings": [
    { "type": "select", "id": "section_background_color", "default": "white", "label": "Achtergrond", "options": [ { "value": "white", "label": "Wit" }, { "value": "lblue", "label": "Lichtblauw" }, { "value": "lpink", "label": "Roze" } ] },
    { "type": "select", "id": "card_background_color", "default": "lpink", "label": "Achtergrond kaart", "options": [ { "value": "lpink", "label": "Roze" }, { "value": "lblue", "label": "Lichtblauw" }, { "value": "yellow", "label": "Geel" }, { "value": "white", "label": "Wit" } ] },
    { "type": "text", "id": "anchor_id", "label": "Anker", "default": "gratis-verzending" },
    { "type": "text", "id": "badge", "label": "Label", "default": "nieuw bij lekker?" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "gratis verzending op je eerste bestelling" },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Meld je aan voor de nieuwsbrief en je krijgt direct een code voor gratis verzending op je eerste bestelling vanaf €15.</p>" },
    { "type": "text", "id": "button_label", "label": "Knoptekst", "default": "ja, ik wil gratis verzending" },
    { "type": "text", "id": "small", "label": "Kleine lettertjes", "default": "Uitschrijven kan altijd." }
  ],
  "presets": [ { "name": "LP gratis verzending" } ]
}
{% endschema %}
