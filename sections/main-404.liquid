<div class="full-page-wrapper-maxed full-page-max-h flex-center-center">
  <div class="template-404 center txtaligncenter padding-b-lg padding-t-lg">
    <h1 tabindex="-1" class="font-fam-bold font-size-xxl color-black txt-uppercase margin-b-sm">{{- 'templates.404.subtext' | t -}}</h1>
    <p class="font-fam-light font-size-sm color-black margin-b-sm">{{- 'templates.404.title' | t -}}</p>
    <a href="{{ routes.root_url }}" title="{{ shop.name | escape }}" class="theme-button theme-button__round-small theme-button__red-white-red">
      {{ 'general.continue_shopping' | t }}
    </a>
  </div>
  <style>div.flex-center-center{display:flex;flex-direction:column;flex-wrap:nowrap;justify-content:center;align-content:center;align-items:center;height:100%}</style>
</div>