{%- liquid
  comment
    //---------------------------------------------//
    //-- general section settings --//
    //---------------------------------------------//
  endcomment

  assign this_section_extra_classes = ''

  assign spacing_t = ' padding-t-'
  assign spacing_t = spacing_t | append : section.settings.row_spacing_inner_top
  assign this_section_extra_classes = this_section_extra_classes | append : spacing_t
  assign spacing_b = ' padding-b-'
  assign spacing_b = spacing_b | append : section.settings.row_spacing_inner_bottom
  assign this_section_extra_classes = this_section_extra_classes | append : spacing_b

  assign this_section_extra_classes = this_section_extra_classes | append : ' bg-' | append : section.settings.section_background_color 

  assign this_section_id = section.id | sha1 | truncate : 20, ""
  assign this_section_id = 'section-' | append : this_section_id
  
comment
  //---------------------------------------------//
  //-- this section/template specific settings --//
  //---------------------------------------------//
endcomment

  assign section_background_color_b = section.settings.section_background_color_b
  assign section_background_color_split = section.settings.section_background_color_split
  if section_background_color_split contains '%'
    assign section_background_color_split_raw = '[BACKGROUND_HEIGHT]'
    assign section_background_color_split_height = section_background_color_split_raw | replace : '[BACKGROUND_HEIGHT]',section_background_color_split
  elsif section_background_color_split contains 'px'
    assign section_background_color_split_raw = '[BACKGROUND_HEIGHT]'
    assign section_background_color_split_height = section_background_color_split_raw | replace : '[BACKGROUND_HEIGHT]',section_background_color_split
  else 
    assign section_background_color_split_raw = 'calc(var(--spacing-[BACKGROUND_HEIGHT]) + 60px )'
    assign section_background_color_split_height = section_background_color_split_raw | replace : '[BACKGROUND_HEIGHT]',section_background_color_split
  endif

  if section_background_color_b != 'none'
    assign extra_css = ''
    assign extra_css = extra_css | append : "#[SECTION_ID]{position:relative;}"
    assign extra_css = extra_css | append : "#[SECTION_ID]::after{content:'';z-index:2;position:absolute;width:100%;height:[BACKGROUND_HEIGHT];right:0;bottom:0;left:0;background:var(--color-[BACKGROUND_B])}"
    assign extra_css = extra_css | append : "#[SECTION_ID]>div{z-index:10;position:relative}"
    assign extra_css = extra_css | replace: '[SECTION_ID]',this_section_id
    assign extra_css = extra_css | replace: '[BACKGROUND_HEIGHT]',section_background_color_split_height
    assign extra_css = extra_css | replace: '[BACKGROUND_B]',section_background_color_b
  endif

assign YOUR_API_KEY = 'AIzaSyBuJmtVLoaSGRIB-ZI6WsEOQdLyaNhtUyo'

-%}

<div id="{{ this_section_id }}" class="{{ this_section_extra_classes }}">
  <div class="{{ this_section_outer_spacing }}">
    <div class="no-page-width no-select">
      <div class="section-inner section-two-cols">
        <div class="two-cols">
          <div class="two-cols-col col-content">
            <div id="map"></div>
          </div>
          <div class="two-cols-col col-content bg-green">
            
          </div>
        </div>
        <script src="{{ 'google-store-map.js' | asset_url }}"></script>
        <script async defer src="https://maps.googleapis.com/maps/api/js?key={{ YOUR_API_KEY }}&libraries=places&callback=initMap&solution_channel=GMP_codelabs_simplestorelocator_v1_a"></script>
      </div>
    </div>
  </div>
</div>

{% capture bloated_css -%}
<style id="{{ this_section_id }}__extra-css">
  {{ extra_css }}
  #map {display:inline-block;width:100%;min-width:50vw;height:100%;min-height:50vw; }
  /* Styling for autocomplete search bar */
  #pac-card {background-color: #fff;border-radius: 2px 0 0 2px;box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);box-sizing: border-box;font-family: Roboto;margin: 10px 10px 0 0;-moz-box-sizing: border-box;outline: none;}
  #pac-container {  padding-top: 12px;  padding-bottom: 12px;  margin-right: 12px;  }
  #pac-input {background-color: #fff;font-family: Roboto;font-size: 15px;font-weight: 300;margin-left: 12px;padding: 0 11px 0 13px;text-overflow: ellipsis;width: 400px;}
  #pac-input:focus { border-color: #4d90fe; }
  #title {color: #fff;background-color: #acbcc9;font-size: 18px;font-weight: 400; padding: 6px 12px; }
  .hidden { display: none; }
  /* Styling for an info pane that slides out from the left. 
  * Hidden by default. */
  #panel { height:300px;width:100px;background-color:red;position: fixed;z-index:100;overflow-x: hidden;transition: all .2s ease-out;}
  .open { width: 250px; }
  .place { font-family: 'open sans', arial, sans-serif;font-size: 1.2em;font-weight: 500;margin-block-end: 0px;padding-left: 18px;padding-right: 18px;}
  .distanceText { color: silver;font-family: 'open sans', arial, sans-serif;font-size: 1em;font-weight: 400;margin-block-start: 0.25em;padding-left: 18px;padding-right: 18px;}
</style>

